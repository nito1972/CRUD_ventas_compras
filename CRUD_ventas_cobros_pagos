length; i++) {\r\n            if (String(dataProv[i][0]).trim() === numProvAsociado) {\r\n              provRow = dataProv[i];\r\n              break;\r\n            }\r\n          }\r\n          if (provRow.length > 0) {\r\n            infoTercero.innerHTML = `\r\n              <strong>Nº ${provRow[0]} - ${provRow[1] || \"\"}</strong><br>\r\n              DNI/CIF: ${provRow[2] || \"\"}<br>\r\n              ${provRow[4] || \"\"}, ${provRow[3] || \"\"} ${provRow[5] || \"\"}<br>\r\n              Tel: ${provRow[7] || \"\"}\r\n            `;\r\n          } else {\r\n            infoTercero.innerHTML = `Proveedor nº ${numProvAsociado}`;\r\n          }\r\n        } else {\r\n          infoTercero.innerHTML = `No se encontró información para el filtro \"${valorBusqueda}\".`;\r\n        }\r\n\r\n        if (encontrados === 0) {\r\n          tablaRegistros.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding: 8px; color: #666;\">No hay historial de pagos para este filtro.</td></tr>`;\r\n        }\r\n      }\r\n    } catch (err) {\r\n      console.error(err);\r\n      infoEmpresa.innerHTML = \"Error al leer datos.\";\r\n    }\r\n  });\r\n}\r\n\r\nfunction cerrarDetalleFactura() {\r\n  const modal = document.getElementById(\"modal-detalle-factura\");\r\n  if (modal) modal.style.display = \"none\";\r\n\r\n  [\"buscador_factura\", \"buscador_fac_compra\", \"buscador_pagos_clientes\", \"buscador_pagos_proveedores\"].forEach((id) => {\r\n    const el = document.getElementById(id) as HTMLInputElement;\r\n    if (el) el.value = \"\";\r\n  });\r\n\r\n  [\r\n    \"btn-ver-detalle-factura\",\r\n    \"btn-ver-detalle-compra\",\r\n    \"btn-ver-detalle-pago-venta\",\r\n    \"btn-ver-detalle-pago-compra\",\r\n    \"btn-registrar-cobro-venta\",\r\n    \"btn-registrar-pago-compra\",\r\n  ].forEach((id) => {\r\n    const btn = document.getElementById(id);\r\n    if (btn) btn.style.display = \"none\";\r\n  });\r\n\r\n  cargarTablaFacturas();\r\n  cargarTablaCompras();\r\n  cargarHistorialCobrosVentas();\r\n  cargarHistorialPagosCompras();\r\n}\r\n\r\nasync function abrirDetalleFactura(tipo: \"venta\" | \"compra\") {\r\n  const modal = document.getElementById(\"modal-detalle-factura\");\r\n  const infoEmpresa = document.getElementById(\"detalle-empresa-info\");\r\n  const infoTercero = document.getElementById(\"detalle-tercero-info\");\r\n  const tituloTercero = document.getElementById(\"detalle-titulo-tercero\");\r\n  const tablaRegistros = document.getElementById(\"detalle-tabla-registros\");\r\n  if (!modal || !infoEmpresa || !infoTercero || !tituloTercero || !tablaRegistros) return;\r\n\r\n  infoEmpresa.innerHTML = \"Cargando empresa...\";\r\n  infoTercero.innerHTML = \"Cargando...\";\r\n  tablaRegistros.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding: 10px;\">Cargando registros...</td></tr>`;\r\n  modal.style.display = \"flex\";\r\n\r\n  const valorBusqueda = (\r\n    document.getElementById(tipo === \"venta\" ? \"buscador_factura\" : \"buscador_fac_compra\") as HTMLInputElement\r\n  ).value.trim();\r\n\r\n  await Excel.run(async (context) => {\r\n    try {\r\n      const sheetEmpresa = context.workbook.worksheets.getItem(\"Empresa\");\r\n      const rangeEmpresa = sheetEmpresa.getUsedRange();\r\n      rangeEmpresa.load(\"values\");\r\n      await context.sync();\r\n\r\n      const valsEmpresa = rangeEmpresa.values as (string | number)[][];\r\n      if (valsEmpresa && valsEmpresa.length > 1) {\r\n        const rowEmp = valsEmpresa[1];\r\n        infoEmpresa.innerHTML = `\r\n          <strong>${rowEmp[1] || \"\"}</strong><br>\r\n          ${rowEmp[2] || \"\"}<br>\r\n          ${rowEmp[3] || \"\"} ${rowEmp[4] || \"\"}<br>\r\n          ${rowEmp[5] || \"\"} (${rowEmp[6] || \"\"})<br>\r\n          Tel: ${rowEmp[7] || \"\"}\r\n        `;\r\n      } else {\r\n        infoEmpresa.innerHTML = \"No se encontraron datos en la hoja Empresa.\";\r\n      }\r\n\r\n      if (tipo === \"venta\") {\r\n        tituloTercero.textContent = \"CLIENTE\";\r\n        const sheetCli = context.workbook.worksheets.getItem(\"Clientes\");\r\n        const rangeCli = sheetCli.getUsedRange();\r\n        rangeCli.load(\"values\");\r\n        await context.sync();\r\n        const dataCli = rangeCli.values as (string | number)[][];\r\n\r\n        let cliRow: (string | number)[] = [];\r\n        for (let i = 1; i < dataCli.length; i++) {\r\n          if (\r\n            String(dataCli[i][0]).trim() === valorBusqueda ||\r\n            String(dataCli[i][1]).trim().toLowerCase().includes(valorBusqueda.toLowerCase())\r\n          ) {\r\n            cliRow = dataCli[i];\r\n            break;\r\n          }\r\n        }\r\n\r\n        if (cliRow.length > 0) {\r\n          infoTercero.innerHTML = `\r\n            <strong>Nº ${cliRow[0]} - ${cliRow[1] || \"\"}</strong><br>\r\n            DNI: ${cliRow[2] || \"\"}<br>\r\n            ${cliRow[4] || \"\"}, ${cliRow[3] || \"\"} ${cliRow[5] || \"\"}<br>\r\n            ${cliRow[6] || \"\"}<br>\r\n            Tel: ${cliRow[7] || \"\"}\r\n          `;\r\n        } else {\r\n          infoTercero.innerHTML = `Cliente con filtro/ID \"${valorBusqueda}\" no encontrado en la base de datos.`;\r\n        }\r\n\r\n        tablaRegistros.innerHTML = \"\";\r\n        let encontrados = 0;\r\n        for (let i = 1; i < datosCacheFacturas.length; i++) {\r\n          const row = datosCacheFacturas[i];\r\n          if (row && row[0]) {\r\n            const idFac = String(row[0] || \"\");\r\n            const numCli = String(row[1] || \"\");\r\n            const formaPago = String(row[2] || \"\");\r\n            const fecha = formatearFechaExcel(row[3]);\r\n            const vencimiento = formatearFechaExcel(row[4]);\r\n            const importe = String(row[5] || \"\");\r\n            const estado = String(row[6] || \"\");\r\n\r\n            if (\r\n              idFac.includes(valorBusqueda) ||\r\n              numCli === valorBusqueda ||\r\n              (cliRow.length > 0 && numCli === String(cliRow[0]))\r\n            ) {\r\n              encontrados++;\r\n              const tr = document.createElement(\"tr\");\r\n              tr.innerHTML = `\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: right;\">${idFac}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${fecha}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${vencimiento}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd;\">${formaPago}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: right;\">${importe} €</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${estado}</td>\r\n              `;\r\n              tablaRegistros.appendChild(tr);\r\n            }\r\n          }\r\n        }\r\n        if (encontrados === 0) {\r\n          tablaRegistros.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding: 8px; color: #666;\">No hay registros de facturas para este filtro.</td></tr>`;\r\n        }\r\n      } else {\r\n        tituloTercero.textContent = \"PROVEEDOR\";\r\n        const sheetProv = context.workbook.worksheets.getItem(\"Proveedores\");\r\n        const rangeProv = sheetProv.getUsedRange();\r\n        rangeProv.load(\"values\");\r\n        await context.sync();\r\n        const dataProv = rangeProv.values as (string | number)[][];\r\n\r\n        let provRow: (string | number)[] = [];\r\n        for (let i = 1; i < dataProv.length; i++) {\r\n          if (\r\n            String(dataProv[i][0]).trim() === valorBusqueda ||\r\n            String(dataProv[i][1]).trim().toLowerCase().includes(valorBusqueda.toLowerCase())\r\n          ) {\r\n            provRow = dataProv[i];\r\n            break;\r\n          }\r\n        }\r\n\r\n        if (provRow.length > 0) {\r\n          infoTercero.innerHTML = `\r\n            <strong>Nº ${provRow[0]} - ${provRow[1] || \"\"}</strong><br>\r\n            DNI/CIF: ${provRow[2] || \"\"}<br>\r\n            ${provRow[4] || \"\"}, ${provRow[3] || \"\"} ${provRow[5] || \"\"}<br>\r\n            ${provRow[6] || \"\"}<br>\r\n            Tel: ${provRow[7] || \"\"}\r\n          `;\r\n        } else {\r\n          infoTercero.innerHTML = `Proveedor con filtro/ID \"${valorBusqueda}\" no encontrado en la base de datos.`;\r\n        }\r\n\r\n        tablaRegistros.innerHTML = \"\";\r\n        let encontrados = 0;\r\n        for (let i = 1; i < datosCacheCompras.length; i++) {\r\n          const row = datosCacheCompras[i];\r\n          if (row && row[0]) {\r\n            const idFac = String(row[0] || \"\");\r\n            const numProv = String(row[1] || \"\");\r\n            const formaPago = String(row[2] || \"\");\r\n            const fecha = formatearFechaExcel(row[3]);\r\n            const vencimiento = formatearFechaExcel(row[4]);\r\n            const importe = String(row[5] || \"\");\r\n            const estado = String(row[6] || \"\");\r\n\r\n            if (\r\n              idFac.includes(valorBusqueda) ||\r\n              numProv === valorBusqueda ||\r\n              (provRow.length > 0 && numProv === String(provRow[0]))\r\n            ) {\r\n              encontrados++;\r\n              const tr = document.createElement(\"tr\");\r\n              tr.innerHTML = `\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: right;\">${idFac}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${fecha}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${vencimiento}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd;\">${formaPago}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: right;\">${importe} €</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${estado}</td>\r\n              `;\r\n              tablaRegistros.appendChild(tr);\r\n            }\r\n          }\r\n        }\r\n        if (encontrados === 0) {\r\n          tablaRegistros.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding: 8px; color: #666;\">No hay registros de compras para este filtro.</td></tr>`;\r\n        }\r\n      }\r\n    } catch (err) {\r\n      console.error(err);\r\n      infoEmpresa.innerHTML = \"Error al leer la hoja Empresa.\";\r\n    }\r\n  });\r\n}\r\n\r\n// ==========================================\r\n// CRUD FACTURAS VENTAS Y COMPRAS\r\n// ==========================================\r\nasync function cargarClientesParaSelect() {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const sheet = context.workbook.worksheets.getItem(\"Clientes\");\r\n      const range = sheet.getUsedRange();\r\n      range.load(\"values\");\r\n      await context.sync();\r\n\r\n      const data = range.values as (string | number)[][];\r\n      const select = document.getElementById(\"fac_num_cliente\") as HTMLSelectElement;\r\n      if (!select) return;\r\n\r\n      select.innerHTML = '<option value=\"\">-- Seleccione un Cliente --</option>';\r\n      mapaClientesNombres = {};\r\n\r\n      for (let i = 1; i < data.length; i++) {\r\n        const row = data[i];\r\n        if (row && row[0]) {\r\n          const numC = String(row[0]).trim();\r\n          const nom = String(row[1] || \"\").trim();\r\n          mapaClientesNombres[numC] = nom;\r\n\r\n          const opt = document.createElement(\"option\");\r\n          opt.value = numC;\r\n          opt.textContent = `${numC} - ${nom}`;\r\n          select.appendChild(opt);\r\n        }\r\n      }\r\n\r\n      const optNuevo = document.createElement(\"option\");\r\n      optNuevo.value = \"NUEVO\";\r\n      optNuevo.textContent = \"➕ [ AÑADIR NUEVO CLIENTE ]\";\r\n      select.appendChild(optNuevo);\r\n    });\r\n  } catch (e) {\r\n    console.log(\"No se pudieron cargar clientes.\");\r\n  }\r\n}\r\n\r\nasync function guardarClienteRapido(nombreNuevo: string, selectEl: HTMLSelectElement) {\r\n  let nuevoIdAsignado = \"\";\r\n  let nombreUpper = nombreNuevo.toUpperCase();\r\n\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Clientes\");\r\n    const usedRange = sheet.getUsedRange();\r\n    usedRange.load(\"rowCount\");\r\n    await context.sync();\r\n\r\n    let maxId = 0;\r\n    for (let i = 1; i < datosCache.length; i++) {\r\n      const val = parseInt(String(datosCache[i][0] || \"0\"), 10);\r\n      if (!isNaN(val) && val > maxId) maxId = val;\r\n    }\r\n    nuevoIdAsignado = String(maxId + 1).padStart(5, \"0\");\r\n\r\n    sheet.getCell(usedRange.rowCount, 0).values = [[nuevoIdAsignado]];\r\n    sheet.getCell(usedRange.rowCount, 1).values = [[nombreUpper]];\r\n    sheet.getCell(usedRange.rowCount, 8).values = [[\"VERDADERO\"]];\r\n    await context.sync();\r\n  });\r\n\r\n  await cargarTablaClientes();\r\n  await cargarClientesParaSelect();\r\n  selectEl.value = nuevoIdAsignado;\r\n  selectEl.focus();\r\n}\r\n\r\nfunction verificarNuevoCliente(selectEl: HTMLSelectElement) {\r\n  if (selectEl.value === \"NUEVO\") {\r\n    abrirModalTercero(\"cliente\", selectEl);\r\n  }\r\n}\r\n\r\nfunction formatearFechaExcel(valor: any): string {\r\n  if (!valor) return \"\";\r\n  let numStr = String(valor).trim();\r\n  if (numStr.includes(\"-\") && numStr.length === 10) {\r\n    const partes = numStr.split(\"-\");\r\n    if (partes.length === 3) return `${partes[2]}/${partes[1]}/${partes[0]}`;\r\n  }\r\n  const num = Number(numStr);\r\n  if (!isNaN(num) && num > 30000) {\r\n    const fechaBase = new Date(1899, 11, 30);\r\n    fechaBase.setDate(fechaBase.getDate() + num);\r\n    const dia = String(fechaBase.getDate()).padStart(2, \"0\");\r\n    const mes = String(fechaBase.getMonth() + 1).padStart(2, \"0\");\r\n    const anio = fechaBase.getFullYear();\r\n    return `${dia}/${mes}/${anio}`;\r\n  }\r\n  return numStr;\r\n}\r\n\r\nfunction sumarDiasHabiles(fechaInicio: Date, dias: number): Date {\r\n  let resultado = new Date(fechaInicio);\r\n  let diasAgregados = 0;\r\n  while (diasAgregados < dias) {\r\n    resultado.setDate(resultado.getDate() + 1);\r\n    const diaSemana = resultado.getDay();\r\n    if (diaSemana !== 0 && diaSemana !== 6) diasAgregados++;\r\n  }\r\n  return resultado;\r\n}\r\n\r\nfunction formatearFechaInput(fecha: Date): string {\r\n  const anio = fecha.getFullYear();\r\n  const mes = String(fecha.getMonth() + 1).padStart(2, \"0\");\r\n  const dia = String(fecha.getDate()).padStart(2, \"0\");\r\n  return `${anio}-${mes}-${dia}`;\r\n}\r\n\r\nfunction procesarFormaPagoYFechas() {\r\n  const formaPagoSelect = document.getElementById(\"fac_forma_pago\") as HTMLSelectElement;\r\n  const fechaInput = document.getElementById(\"fac_fecha\") as HTMLInputElement;\r\n  const vencimientoInput = document.getElementById(\"fac_vencimiento\") as HTMLInputElement;\r\n  const estadoSelect = document.getElementById(\"fac_estado\") as HTMLSelectElement;\r\n\r\n  if (!formaPagoSelect || !fechaInput || !vencimientoInput || !estadoSelect) return;\r\n  const formaPago = formaPagoSelect.value;\r\n  const fechaVal = fechaInput.value;\r\n  if (!fechaVal) return;\r\n\r\n  const fechaBase = new Date(fechaVal + \"T00:00:00\");\r\n  if (isNaN(fechaBase.getTime())) return;\r\n\r\n  if (formaPago === \"CONTADO\" || formaPago === \"BIZUM\") {\r\n    vencimientoInput.value = fechaVal;\r\n    estadoSelect.value = \"PAGADA\";\r\n  } else if (formaPago === \"GIRO 30\") {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 30));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago === \"GIRO 60\") {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 60));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago === \"GIRO 85\") {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 85));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago === \"TRANSFERENCIA\") {\r\n    const nuevaFecha = new Date(fechaBase);\r\n    nuevaFecha.setDate(nuevaFecha.getDate() + 30);\r\n    vencimientoInput.value = formatearFechaInput(nuevaFecha);\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago) {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 30));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  }\r\n}\r\n\r\nasync function guardarFactura() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Facturas_ventas\");\r\n    const datos = obtenerValoresFormularioFactura();\r\n    if (!datos.idFactura || !datos.numCliente) {\r\n      alert(\"El ID de factura y el cliente son obligatorios.\");\r\n      return;\r\n    }\r\n\r\n    const usedRange = sheet.getUsedRange();\r\n    usedRange.load(\"rowCount\");\r\n    await context.sync();\r\n\r\n    escribirFilaFactura(sheet, usedRange.rowCount, datos);\r\n\r\n    // VALIDACIÓN AUTOMÁTICA SEGÚN FORMA DE PAGO INMEDIATA\r\n    const formaPagoUpper = datos.formaPago.toUpperCase();\r\n    if (formaPagoUpper && !formaPagoUpper.includes(\"GIRO\")) {\r\n      const sheetHist = context.workbook.worksheets.getItem(\"Historial_Cobros_Ventas\");\r\n      const usedHist = sheetHist.getUsedRange();\r\n      usedHist.load(\"rowCount\");\r\n      await context.sync();\r\n\r\n      const rowIndexHist = usedHist.rowCount;\r\n      sheetHist.getCell(rowIndexHist, 0).values = [[datos.idFactura]];\r\n      sheetHist.getCell(rowIndexHist, 1).values = [[datos.numCliente]];\r\n      sheetHist.getCell(rowIndexHist, 2).values = [[datos.fecha || new Date().toISOString().split(\"T\")[0]]];\r\n      sheetHist.getCell(rowIndexHist, 3).values = [[parseFloat(datos.importe) || 0]];\r\n      sheetHist.getCell(rowIndexHist, 4).values = [[datos.formaPago]];\r\n      sheetHist.getCell(rowIndexHist, 5).values = [[\"Cobro automático por pago inmediato\"]];\r\n      sheetHist.getCell(rowIndexHist, 6).values = [[datos.logUser]];\r\n    }\r\n\r\n    await context.sync();\r\n    alert(\"¡Factura de venta guardada correctamente!\");\r\n    limpiarFormularioFactura();\r\n    await cargarTablaFacturas();\r\n  });\r\n}\r\n\r\nasync function actualizarFactura() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Facturas_ventas\");\r\n    const datos = obtenerValoresFormularioFactura();\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === datos.idFactura) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"No se encontró la factura.\");\r\n      return;\r\n    }\r\n\r\n    escribirFilaFactura(sheet, rowIndex, datos);\r\n\r\n    // VALIDACIÓN AUTOMÁTICA SEGÚN FORMA DE PAGO INMEDIATA EN ACTUALIZACIÓN\r\n    const formaPagoUpper = datos.formaPago.toUpperCase();\r\n    if (formaPagoUpper && !formaPagoUpper.includes(\"GIRO\")) {\r\n      const sheetHist = context.workbook.worksheets.getItem(\"Historial_Cobros_Ventas\");\r\n      const usedHist = sheetHist.getUsedRange();\r\n      usedHist.load(\"rowCount\");\r\n      await context.sync();\r\n\r\n      const rowIndexHist = usedHist.rowCount;\r\n      sheetHist.getCell(rowIndexHist, 0).values = [[datos.idFactura]];\r\n      sheetHist.getCell(rowIndexHist, 1).values = [[datos.numCliente]];\r\n      sheetHist.getCell(rowIndexHist, 2).values = [[datos.fecha || new Date().toISOString().split(\"T\")[0]]];\r\n      sheetHist.getCell(rowIndexHist, 3).values = [[parseFloat(datos.importe) || 0]];\r\n      sheetHist.getCell(rowIndexHist, 4).values = [[datos.formaPago]];\r\n      sheetHist.getCell(rowIndexHist, 5).values = [[\"Cobro automático actualización\"]];\r\n      sheetHist.getCell(rowIndexHist, 6).values = [[datos.logUser]];\r\n    }\r\n\r\n    await context.sync();\r\n    alert(\"¡Factura actualizada correctamente!\");\r\n    limpiarFormularioFactura();\r\n    await cargarTablaFacturas();\r\n  });\r\n}\r\n\r\nasync function eliminarFactura() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Facturas_ventas\");\r\n    const inputId = document.getElementById(\"fac_id\") as HTMLInputElement;\r\n    if (!inputId) return;\r\n    const idFactura = inputId.value.trim();\r\n\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === idFactura) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"Factura no encontrada.\");\r\n      return;\r\n    }\r\n\r\n    sheet.getRangeByIndexes(rowIndex, 0, 1, 8).delete(Excel.DeleteShiftDirection.up);\r\n    await context.sync();\r\n    alert(\"Factura eliminada.\");\r\n    limpiarFormularioFactura();\r\n    await cargarTablaFacturas();\r\n  });\r\n}\r\n\r\nasync function cargarTablaFacturas() {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const sheet = context.workbook.worksheets.getItem(\"Facturas_ventas\");\r\n      const range = sheet.getUsedRange();\r\n      range.load(\"values\");\r\n      await context.sync();\r\n\r\n      datosCacheFacturas = range.values as (string | number)[][];\r\n      renderizarTablaFacturas(datosCacheFacturas);\r\n      generarSiguienteIdFactura(datosCacheFacturas);\r\n    });\r\n  } catch (e) {\r\n    console.log(\"Esperando datos de Facturas_ventas...\");\r\n  }\r\n}\r\n\r\nfunction generarSiguienteIdFactura(data: (string | number)[][]) {\r\n  let maxId = 0;\r\n  for (let i = 1; i < data.length; i++) {\r\n    const val = parseInt(String(data[i][0] || \"0\"), 10);\r\n    if (!isNaN(val) && val > maxId) maxId = val;\r\n  }\r\n  const inputNum = document.getElementById(\"fac_id\") as HTMLInputElement;\r\n  if (inputNum && !inputNum.disabled) {\r\n    inputNum.value = String(maxId + 1).padStart(5, \"0\");\r\n  }\r\n}\r\n\r\nfunction renderizarTablaFacturas(data: (string | number)[][], filtro: string = \"\") {\r\n  const tbody = document.getElementById(\"tbody-facturas\");\r\n  if (!tbody) return;\r\n  tbody.innerHTML = \"\";\r\n  const filtroTexto = filtro.toLowerCase();\r\n\r\n  for (let i = 1; i < data.length; i++) {\r\n    const row = data[i];\r\n    if (row && row[0]) {\r\n      const idFac = String(row[0] || \"\");\r\n      const numCli = String(row[1] || \"\");\r\n      const nombreCli = mapaClientesNombres[numCli] || \"Cliente Desconocido\";\r\n      const fecha = formatearFechaExcel(row[3]);\r\n      const vencimiento = formatearFechaExcel(row[4]);\r\n      const importe = String(row[5] || \"\");\r\n      const estado = String(row[6] || \"\");\r\n\r\n      if (\r\n        filtroTexto &&\r\n        !idFac.toLowerCase().includes(filtroTexto) &&\r\n        !numCli.toLowerCase().includes(filtroTexto) &&\r\n        !nombreCli.toLowerCase().includes(filtroTexto) &&\r\n        !estado.toLowerCase().includes(filtroTexto)\r\n      )\r\n        continue;\r\n\r\n      const tr = document.createElement(\"tr\");\r\n      tr.innerHTML = `\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${idFac}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${numCli}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; font-weight: 600;\">${nombreCli}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${fecha}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${vencimiento}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${importe}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${estado}</td>\r\n      `;\r\n      tr.onclick = () => seleccionarFacturaFila(row);\r\n      tbody.appendChild(tr);\r\n    }\r\n  }\r\n}\r\n\r\nfunction seleccionarFacturaFila(row: (string | number)[]) {\r\n  const setVal = (id: string, val: string) => {\r\n    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;\r\n    if (el) el.value = val;\r\n  };\r\n  setVal(\"fac_id\", String(row[0] || \"\"));\r\n  setVal(\"fac_num_cliente\", String(row[1] || \"\"));\r\n  setVal(\"fac_forma_pago\", String(row[2] || \"\"));\r\n  setVal(\"fac_fecha\", String(row[3] || \"\"));\r\n  setVal(\"fac_vencimiento\", String(row[4] || \"\"));\r\n  setVal(\"fac_importe\", String(row[5] || \"\"));\r\n  setVal(\"fac_estado\", String(row[6] || \"PENDIENTE\"));\r\n\r\n  document.getElementById(\"btn-guardar-factura\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-actualizar-factura\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-eliminar-factura\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-registrar-cobro-venta\")!.style.display = \"inline-flex\";\r\n  (document.getElementById(\"fac_id\") as HTMLInputElement).disabled = true;\r\n}\r\n\r\nfunction limpiarFormularioFactura() {\r\n  // CORRECCIÓN 1: Limpiar también el input de buscar\r\n  const buscadorFac = document.getElementById(\"buscador_factura\") as HTMLInputElement;\r\n  if (buscadorFac) buscadorFac.value = \"\";\r\n\r\n  document.querySelectorAll(\"#vista-facturas_ventas input\").forEach((input) => {\r\n    const el = input as HTMLInputElement;\r\n    if (el.id !== \"buscador_factura\") el.value = \"\";\r\n  });\r\n  (document.getElementById(\"fac_num_cliente\") as HTMLSelectElement).value = \"\";\r\n  (document.getElementById(\"fac_forma_pago\") as HTMLSelectElement).value = \"\";\r\n  (document.getElementById(\"fac_estado\") as HTMLSelectElement).value = \"PENDIENTE\";\r\n\r\n  document.getElementById(\"btn-guardar-factura\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-actualizar-factura\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-eliminar-factura\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-registrar-cobro-venta\")!.style.display = \"none\";\r\n  (document.getElementById(\"fac_id\") as HTMLInputElement).disabled = false;\r\n  generarSiguienteIdFactura(datosCacheFacturas);\r\n  document.getElementById(\"btn-ver-detalle-factura\")!.style.display = \"none\";\r\n  renderizarTablaFacturas(datosCacheFacturas);\r\n}\r\n\r\nfunction obtenerValoresFormularioFactura() {\r\n  const getVal = (id: string) => {\r\n    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;\r\n    return el ? el.value.trim() : \"\";\r\n  };\r\n  return {\r\n    idFactura: getVal(\"fac_id\"),\r\n    numCliente: getVal(\"fac_num_cliente\"),\r\n    formaPago: getVal(\"fac_forma_pago\"),\r\n    fecha: getVal(\"fac_fecha\"),\r\n    vencimiento: getVal(\"fac_vencimiento\"),\r\n    importe: getVal(\"fac_importe\"),\r\n    estado: getVal(\"fac_estado\"),\r\n    logUser: usuarioActual || \"SISTEMA\",\r\n  };\r\n}\r\n\r\nfunction escribirFilaFactura(sheet: Excel.Worksheet, rowIndex: number, datos: any) {\r\n  sheet.getCell(rowIndex, 0).values = [[datos.idFactura]];\r\n  sheet.getCell(rowIndex, 1).values = [[datos.numCliente]];\r\n  sheet.getCell(rowIndex, 2).values = [[datos.formaPago]];\r\n  sheet.getCell(rowIndex, 3).values = [[datos.fecha]];\r\n  sheet.getCell(rowIndex, 4).values = [[datos.vencimiento]];\r\n  sheet.getCell(rowIndex, 5).values = [[datos.importe]];\r\n  sheet.getCell(rowIndex, 6).values = [[datos.estado]];\r\n  sheet.getCell(rowIndex, 7).values = [[datos.logUser]];\r\n}\r\n\r\n// CRUD COMPRAS\r\nasync function cargarProveedoresParaSelect() {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const sheet = context.workbook.worksheets.getItem(\"Proveedores\");\r\n      const range = sheet.getUsedRange();\r\n      range.load(\"values\");\r\n      await context.sync();\r\n\r\n      const data = range.values as (string | number)[][];\r\n      const select = document.getElementById(\"com_num_proveedor\") as HTMLSelectElement;\r\n      if (!select) return;\r\n\r\n      select.innerHTML = '<option value=\"\">-- Seleccione un Proveedor --</option>';\r\n      mapaProveedoresNombres = {};\r\n\r\n      for (let i = 1; i < data.length; i++) {\r\n        const row = data[i];\r\n        if (row && row[0]) {\r\n          const numP = String(row[0]).trim();\r\n          const nom = String(row[1] || \"\").trim();\r\n          mapaProveedoresNombres[numP] = nom;\r\n\r\n          const opt = document.createElement(\"option\");\r\n          opt.value = numP;\r\n          opt.textContent = `${numP} - ${nom}`;\r\n          select.appendChild(opt);\r\n        }\r\n      }\r\n\r\n      const optNuevo = document.createElement(\"option\");\r\n      optNuevo.value = \"NUEVO\";\r\n      optNuevo.textContent = \"➕ [ AÑADIR NUEVO PROVEEDOR ]\";\r\n      select.appendChild(optNuevo);\r\n    });\r\n  } catch (e) {\r\n    console.log(\"No se pudieron cargar proveedores.\");\r\n  }\r\n}\r\n\r\nasync function guardarProveedorRapido(nombreNuevo: string, selectEl: HTMLSelectElement) {\r\n  let nuevoIdAsignado = \"\";\r\n  let nombreUpper = nombreNuevo.toUpperCase();\r\n\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Proveedores\");\r\n    const usedRange = sheet.getUsedRange();\r\n    usedRange.load(\"rowCount\");\r\n    await context.sync();\r\n\r\n    let maxId = 0;\r\n    for (let i = 1; i < datosCacheProv.length; i++) {\r\n      const val = parseInt(String(datosCacheProv[i][0] || \"0\"), 10);\r\n      if (!isNaN(val) && val > maxId) maxId = val;\r\n    }\r\n    nuevoIdAsignado = String(maxId + 1).padStart(5, \"0\");\r\n\r\n    sheet.getCell(usedRange.rowCount, 0).values = [[nuevoIdAsignado]];\r\n    sheet.getCell(usedRange.rowCount, 1).values = [[nombreUpper]];\r\n    sheet.getCell(usedRange.rowCount, 8).values = [[\"VERDADERO\"]];\r\n    await context.sync();\r\n  });\r\n\r\n  await cargarTablaProveedores();\r\n  await cargarProveedoresParaSelect();\r\n  selectEl.value = nuevoIdAsignado;\r\n  selectEl.focus();\r\n}\r\n\r\nfunction verificarNuevoProveedor(selectEl: HTMLSelectElement) {\r\n  if (selectEl.value === \"NUEVO\") {\r\n    abrirModalTercero(\"proveedor\", selectEl);\r\n  }\r\n}\r\n\r\nfunction procesarFormaPagoYFechasCompra() {\r\n  const formaPagoSelect = document.getElementById(\"com_forma_pago\") as HTMLSelectElement;\r\n  const fechaInput = document.getElementById(\"com_fecha\") as HTMLInputElement;\r\n  const vencimientoInput = document.getElementById(\"com_vencimiento\") as HTMLInputElement;\r\n  const estadoSelect = document.getElementById(\"com_estado\") as HTMLSelectElement;\r\n\r\n  if (!formaPagoSelect || !fechaInput || !vencimientoInput || !estadoSelect) return;\r\n  const formaPago = formaPagoSelect.value;\r\n  const fechaVal = fechaInput.value;\r\n  if (!fechaVal) return;\r\n\r\n  const fechaBase = new Date(fechaVal + \"T00:00:00\");\r\n  if (isNaN(fechaBase.getTime())) return;\r\n\r\n  if (formaPago === \"CONTADO\" || formaPago === \"BIZUM\") {\r\n    vencimientoInput.value = fechaVal;\r\n    estadoSelect.value = \"PAGADA\";\r\n  } else if (formaPago === \"GIRO 30\") {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 30));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago === \"GIRO 60\") {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 60));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago === \"GIRO 85\") {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 85));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago === \"TRANSFERENCIA\") {\r\n    const nuevaFecha = new Date(fechaBase);\r\n    nuevaFecha.setDate(nuevaFecha.getDate() + 30);\r\n    vencimientoInput.value = formatearFechaInput(nuevaFecha);\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  } else if (formaPago) {\r\n    vencimientoInput.value = formatearFechaInput(sumarDiasHabiles(fechaBase, 30));\r\n    estadoSelect.value = \"PENDIENTE\";\r\n  }\r\n}\r\n\r\nasync function guardarCompra() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Facturas_compras\");\r\n    const datos = obtenerValoresFormularioCompra();\r\n    if (!datos.idFactura || !datos.numProveedor) {\r\n      alert(\"El ID de factura y el proveedor son obligatorios.\");\r\n      return;\r\n    }\r\n\r\n    const usedRange = sheet.getUsedRange();\r\n    usedRange.load(\"rowCount\");\r\n    await context.sync();\r\n\r\n    escribirFilaCompra(sheet, usedRange.rowCount, datos);\r\n\r\n    // VALIDACIÓN AUTOMÁTICA SEGÚN FORMA DE PAGO INMEDIATA EN COMPRAS\r\n    const formaPagoUpper = datos.formaPago.toUpperCase();\r\n    if (formaPagoUpper && !formaPagoUpper.includes(\"GIRO\")) {\r\n      const sheetHist = context.workbook.worksheets.getItem(\"Historial_Pagos_Compras\");\r\n      const usedHist = sheetHist.getUsedRange();\r\n      usedHist.load(\"rowCount\");\r\n      await context.sync();\r\n\r\n      const rowIndexHist = usedHist.rowCount;\r\n      sheetHist.getCell(rowIndexHist, 0).values = [[datos.idFactura]];\r\n      sheetHist.getCell(rowIndexHist, 1).values = [[datos.numProveedor]];\r\n      sheetHist.getCell(rowIndexHist, 2).values = [[datos.fecha || new Date().toISOString().split(\"T\")[0]]];\r\n      sheetHist.getCell(rowIndexHist, 3).values = [[parseFloat(datos.importe) || 0]];\r\n      sheetHist.getCell(rowIndexHist, 4).values = [[datos.formaPago]];\r\n      sheetHist.getCell(rowIndexHist, 5).values = [[\"Pago automático por pago inmediato\"]];\r\n      sheetHist.getCell(rowIndexHist, 6).values = [[datos.logUser]];\r\n    }\r\n\r\n    await context.sync();\r\n    alert(\"¡Factura de compra guardada correctamente!\");\r\n    limpiarFormularioCompra();\r\n    await cargarTablaCompras();\r\n  });\r\n}\r\n\r\nasync function actualizarCompra() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Facturas_compras\");\r\n    const datos = obtenerValoresFormularioCompra();\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === datos.idFactura) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"No se encontró la factura de compra.\");\r\n      return;\r\n    }\r\n\r\n    escribirFilaCompra(sheet, rowIndex, datos);\r\n\r\n    // VALIDACIÓN AUTOMÁTICA SEGÚN FORMA DE PAGO INMEDIATA EN ACTUALIZACIÓN DE COMPRAS\r\n    const formaPagoUpper = datos.formaPago.toUpperCase();\r\n    if (formaPagoUpper && !formaPagoUpper.includes(\"GIRO\")) {\r\n      const sheetHist = context.workbook.worksheets.getItem(\"Historial_Pagos_Compras\");\r\n      const usedHist = sheetHist.getUsedRange();\r\n      usedHist.load(\"rowCount\");\r\n      await context.sync();\r\n\r\n      const rowIndexHist = usedHist.rowCount;\r\n      sheetHist.getCell(rowIndexHist, 0).values = [[datos.idFactura]];\r\n      sheetHist.getCell(rowIndexHist, 1).values = [[datos.numProveedor]];\r\n      sheetHist.getCell(rowIndexHist, 2).values = [[datos.fecha || new Date().toISOString().split(\"T\")[0]]];\r\n      sheetHist.getCell(rowIndexHist, 3).values = [[parseFloat(datos.importe) || 0]];\r\n      sheetHist.getCell(rowIndexHist, 4).values = [[datos.formaPago]];\r\n      sheetHist.getCell(rowIndexHist, 5).values = [[\"Pago automático actualización\"]];\r\n      sheetHist.getCell(rowIndexHist, 6).values = [[datos.logUser]];\r\n    }\r\n\r\n    await context.sync();\r\n    alert(\"¡Factura de compra actualizada correctamente!\");\r\n    limpiarFormularioCompra();\r\n    await cargarTablaCompras();\r\n  });\r\n}\r\n\r\nasync function eliminarCompra() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Facturas_compras\");\r\n    const inputId = document.getElementById(\"com_id\") as HTMLInputElement;\r\n    if (!inputId) return;\r\n    const idFactura = inputId.value.trim();\r\n\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === idFactura) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"Factura de compra no encontrada.\");\r\n      return;\r\n    }\r\n\r\n    sheet.getRangeByIndexes(rowIndex, 0, 1, 8).delete(Excel.DeleteShiftDirection.up);\r\n    await context.sync();\r\n    alert(\"Factura de compra eliminada.\");\r\n    limpiarFormularioCompra();\r\n    await cargarTablaCompras();\r\n  });\r\n}\r\n\r\nasync function cargarTablaCompras() {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const sheet = context.workbook.worksheets.getItem(\"Facturas_compras\");\r\n      const range = sheet.getUsedRange();\r\n      range.load(\"values\");\r\n      await context.sync();\r\n\r\n      datosCacheCompras = range.values as (string | number)[][];\r\n      renderizarTablaCompras(datosCacheCompras);\r\n      generarSiguienteIdCompra(datosCacheCompras);\r\n    });\r\n  } catch (e) {\r\n    console.log(\"Esperando datos de Facturas_compras...\");\r\n  }\r\n}\r\n\r\nfunction generarSiguienteIdCompra(data: (string | number)[][]) {\r\n  let maxId = 0;\r\n  for (let i = 1; i < data.length; i++) {\r\n    const val = parseInt(String(data[i][0] || \"0\"), 10);\r\n    if (!isNaN(val) && val > maxId) maxId = val;\r\n  }\r\n  const inputNum = document.getElementById(\"com_id\") as HTMLInputElement;\r\n  if (inputNum && !inputNum.disabled) {\r\n    inputNum.value = String(maxId + 1).padStart(5, \"0\");\r\n  }\r\n}\r\n\r\nfunction renderizarTablaCompras(data: (string | number)[][], filtro: string = \"\") {\r\n  const tbody = document.getElementById(\"tbody-facturas-compras\");\r\n  if (!tbody) return;\r\n  tbody.innerHTML = \"\";\r\n  const filtroTexto = filtro.toLowerCase();\r\n\r\n  for (let i = 1; i < data.length; i++) {\r\n    const row = data[i];\r\n    if (row && row[0]) {\r\n      const idFac = String(row[0] || \"\");\r\n      const numProv = String(row[1] || \"\");\r\n      const nombreProv = mapaProveedoresNombres[numProv] || \"Proveedor Desconocido\";\r\n      const fecha = formatearFechaExcel(row[3]);\r\n      const vencimiento = formatearFechaExcel(row[4]);\r\n      const importe = String(row[5] || \"\");\r\n      const estado = String(row[6] || \"\");\r\n\r\n      if (\r\n        filtroTexto &&\r\n        !idFac.toLowerCase().includes(filtroTexto) &&\r\n        !numProv.toLowerCase().includes(filtroTexto) &&\r\n        !nombreProv.toLowerCase().includes(filtroTexto) &&\r\n        !estado.toLowerCase().includes(filtroTexto)\r\n      )\r\n        continue;\r\n\r\n      const tr = document.createElement(\"tr\");\r\n      tr.innerHTML = `\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${idFac}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${numProv}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; font-weight: 600;\">${nombreProv}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${fecha}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${vencimiento}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${importe}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${estado}</td>\r\n      `;\r\n      tr.onclick = () => seleccionarCompraFila(row);\r\n      tbody.appendChild(tr);\r\n    }\r\n  }\r\n}\r\n\r\nfunction seleccionarCompraFila(row: (string | number)[]) {\r\n  const setVal = (id: string, val: string) => {\r\n    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;\r\n    if (el) el.value = val;\r\n  };\r\n  setVal(\"com_id\", String(row[0] || \"\"));\r\n  setVal(\"com_num_proveedor\", String(row[1] || \"\"));\r\n  setVal(\"com_forma_pago\", String(row[2] || \"\"));\r\n  setVal(\"com_fecha\", String(row[3] || \"\"));\r\n  setVal(\"com_vencimiento\", String(row[4] || \"\"));\r\n  setVal(\"com_importe\", String(row[5] || \"\"));\r\n  setVal(\"com_estado\", String(row[6] || \"PENDIENTE\"));\r\n\r\n  document.getElementById(\"btn-guardar-compra\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-actualizar-compra\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-eliminar-compra\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-registrar-pago-compra\")!.style.display = \"inline-flex\";\r\n  (document.getElementById(\"com_id\") as HTMLInputElement).disabled = true;\r\n}\r\n\r\nfunction limpiarFormularioCompra() {\r\n  // CORRECCIÓN 1: Limpiar también el input de buscar de compras\r\n  const buscadorFacComp = document.getElementById(\"buscador_fac_compra\") as HTMLInputElement;\r\n  if (buscadorFacComp) buscadorFacComp.value = \"\";\r\n\r\n  document.querySelectorAll(\"#vista-facturas_compras input\").forEach((input) => {\r\n    const el = input as HTMLInputElement;\r\n    if (el.id !== \"buscador_fac_compra\") el.value = \"\";\r\n  });\r\n  (document.getElementById(\"com_num_proveedor\") as HTMLSelectElement).value = \"\";\r\n  (document.getElementById(\"com_forma_pago\") as HTMLSelectElement).value = \"\";\r\n  (document.getElementById(\"com_estado\") as HTMLSelectElement).value = \"PENDIENTE\";\r\n\r\n  document.getElementById(\"btn-guardar-compra\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-actualizar-compra\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-eliminar-compra\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-registrar-pago-compra\")!.style.display = \"none\";\r\n  (document.getElementById(\"com_id\") as HTMLInputElement).disabled = false;\r\n  generarSiguienteIdCompra(datosCacheCompras);\r\n  document.getElementById(\"btn-ver-detalle-compra\")!.style.display = \"none\";\r\n  renderizarTablaCompras(datosCacheCompras);\r\n}\r\n\r\nfunction obtenerValoresFormularioCompra() {\r\n  const getVal = (id: string) => {\r\n    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;\r\n    return el ? el.value.trim() : \"\";\r\n  };\r\n  return {\r\n    idFactura: getVal(\"com_id\"),\r\n    numProveedor: getVal(\"com_num_proveedor\"),\r\n    formaPago: getVal(\"com_forma_pago\"),\r\n    fecha: getVal(\"com_fecha\"),\r\n    vencimiento: getVal(\"com_vencimiento\"),\r\n    importe: getVal(\"com_importe\"),\r\n    estado: getVal(\"com_estado\"),\r\n    logUser: usuarioActual || \"SISTEMA\",\r\n  };\r\n}\r\n\r\nfunction escribirFilaCompra(sheet: Excel.Worksheet, rowIndex: number, datos: any) {\r\n  sheet.getCell(rowIndex, 0).values = [[datos.idFactura]];\r\n  sheet.getCell(rowIndex, 1).values = [[datos.numProveedor]];\r\n  sheet.getCell(rowIndex, 2).values = [[datos.formaPago]];\r\n  sheet.getCell(rowIndex, 3).values = [[datos.fecha]];\r\n  sheet.getCell(rowIndex, 4).values = [[datos.vencimiento]];\r\n  sheet.getCell(rowIndex, 5).values = [[datos.importe]];\r\n  sheet.getCell(rowIndex, 6).values = [[datos.estado]];\r\n  sheet.getCell(rowIndex, 7).values = [[datos.logUser]];\r\n}\r\n\r\n// ==========================================\r\n// INICIALIZACIÓN GLOBAL\r\n// ==========================================\r\nOffice.onReady(() => {\r\n  mostrarModalLogin();\r\n\r\n  document.addEventListener(\"input\", (e) => {\r\n    const target = e.target as HTMLInputElement;\r\n    if (target && target.classList.contains(\"mayus\")) {\r\n      const start = target.selectionStart;\r\n      const end = target.selectionEnd;\r\n      target.value = target.value.toUpperCase();\r\n      target.setSelectionRange(start, end);\r\n    }\r\n  });\r\n\r\n  // Clientes\r\n  document.getElementById(\"btn-guardar\")?.addEventListener(\"click\", guardarCliente);\r\n  document.getElementById(\"btn-actualizar\")?.addEventListener(\"click\", actualizarCliente);\r\n  document.getElementById(\"btn-eliminar\")?.addEventListener(\"click\", eliminarCliente);\r\n  document.getElementById(\"btn-limpiar\")?.addEventListener(\"click\", limpiarFormulario);\r\n  const buscadorCli = document.getElementById(\"buscador\") as HTMLInputElement;\r\n  if (buscadorCli)\r\n    buscadorCli.addEventListener(\"input\", (e) => renderizarTabla(datosCache, (e.target as HTMLInputElement).value));\r\n\r\n  // Proveedores\r\n  document.getElementById(\"btn-guardar-prov\")?.addEventListener(\"click\", guardarProveedor);\r\n  document.getElementById(\"btn-actualizar-prov\")?.addEventListener(\"click\", actualizarProveedor);\r\n  document.getElementById(\"btn-eliminar-prov\")?.addEventListener(\"click\", eliminarProveedor);\r\n  document.getElementById(\"btn-limpiar-prov\")?.addEventListener(\"click\", limpiarFormularioProv);\r\n  const buscadorProv = document.getElementById(\"buscador_prov\") as HTMLInputElement;\r\n  if (buscadorProv)\r\n    buscadorProv.addEventListener(\"input\", (e) =>\r\n      renderizarTablaProv(datosCacheProv, (e.target as HTMLInputElement).value),\r\n    );\r\n\r\n  // Facturas Ventas\r\n  document.getElementById(\"btn-guardar-factura\")?.addEventListener(\"click\", guardarFactura);\r\n  document.getElementById(\"btn-actualizar-factura\")?.addEventListener(\"click\", actualizarFactura);\r\n  document.getElementById(\"btn-eliminar-factura\")?.addEventListener(\"click\", eliminarFactura);\r\n  document.getElementById(\"btn-limpiar-factura\")?.addEventListener(\"click\", limpiarFormularioFactura);\r\n  document.getElementById(\"fac_forma_pago\")?.addEventListener(\"change\", procesarFormaPagoYFechas);\r\n  document.getElementById(\"fac_fecha\")?.addEventListener(\"change\", procesarFormaPagoYFechas);\r\n  const buscadorFact = document.getElementById(\"buscador_factura\") as HTMLInputElement;\r\n  if (buscadorFact) {\r\n    buscadorFact.addEventListener(\"input\", (e) =>\r\n      renderizarTablaFacturas(datosCacheFacturas, (e.target as HTMLInputElement).value),\r\n    );\r\n    buscadorFact.addEventListener(\"keydown\", (e) => manejarEnterBuscadorFacturas(e, \"venta\"));\r\n  }\r\n\r\n  // Facturas Compras\r\n  document.getElementById(\"btn-guardar-compra\")?.addEventListener(\"click\", guardarCompra);\r\n  document.getElementById(\"btn-actualizar-compra\")?.addEventListener(\"click\", actualizarCompra);\r\n  document.getElementById(\"btn-eliminar-compra\")?.addEventListener(\"click\", eliminarCompra);\r\n  document.getElementById(\"btn-limpiar-compra\")?.addEventListener(\"click\", limpiarFormularioCompra);\r\n  document.getElementById(\"com_forma_pago\")?.addEventListener(\"change\", procesarFormaPagoYFechasCompra);\r\n  document.getElementById(\"com_fecha\")?.addEventListener(\"change\", procesarFormaPagoYFechasCompra);\r\n  const buscadorCompra = document.getElementById(\"buscador_fac_compra\") as HTMLInputElement;\r\n  if (buscadorCompra) {\r\n    buscadorCompra.addEventListener(\"input\", (e) =>\r\n      renderizarTablaCompras(datosCacheCompras, (e.target as HTMLInputElement).value),\r\n    );\r\n    buscadorCompra.addEventListener(\"keydown\", (e) => manejarEnterBuscadorFacturas(e, \"compra\"));\r\n  }\r\n\r\n  // Historial Pagos Clientes\r\n  const buscadorPagosCli = document.getElementById(\"buscador_pagos_clientes\") as HTMLInputElement;\r\n  if (buscadorPagosCli) {\r\n    buscadorPagosCli.addEventListener(\"input\", (e) =>\r\n      renderizarTablaCobrosVentas(datosCacheCobrosVentas, (e.target as HTMLInputElement).value),\r\n    );\r\n    buscadorPagosCli.addEventListener(\"keydown\", (e) => manejarEnterBuscadorPagos(e, \"venta\"));\r\n  }\r\n\r\n  // Historial Pagos Proveedores\r\n  const buscadorPagosProv = document.getElementById(\"buscador_pagos_proveedores\") as HTMLInputElement;\r\n  if (buscadorPagosProv) {\r\n    buscadorPagosProv.addEventListener(\"input\", (e) =>\r\n      renderizarTablaPagosCompras(datosCachePagosCompras, (e.target as HTMLInputElement).value),\r\n    );\r\n    buscadorPagosProv.addEventListener(\"keydown\", (e) => manejarEnterBuscadorPagos(e, \"compra\"));\r\n  }\r\n\r\n  limpiarFormulario();\r\n  limpiarFormularioProv();\r\n  cargarTablaClientes();\r\n});\r\n\r\n// ==========================================\r\n// FUNCIÓN GLOBAL DE IMPRESIÓN / PREPARAR HOJA\r\n// ==========================================\r\n(window as any).prepararHojaImpresion = async function (tipo: string = \"ventas\") {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const libro = context.workbook;\r\n\r\n      const nombreHoja = tipo === \"compras\" ? \"Imprimir_Facturas_Compras\" : \"Listado\";\r\n      const tituloReporte = tipo === \"compras\" ? \"HISTORIAL DE PAGOS / COMPRAS\" : \"HISTORIAL DE COBROS / VENTAS\";\r\n\r\n      let hojaPreview;\r\n\r\n      try {\r\n        const hojaExistente = libro.worksheets.getItem(nombreHoja);\r\n        hojaExistente.delete();\r\n        await context.sync();\r\n      } catch (e) {}\r\n\r\n      hojaPreview = libro.worksheets.add(nombreHoja);\r\n      hojaPreview.activate();\r\n\r\n      const empresaInfo = document.getElementById(\"detalle-empresa-info\")?.innerText || \"\";\r\n      const terceroTitulo = document.getElementById(\"detalle-titulo-tercero\")?.innerText || \"TERCERO\";\r\n      const terceroInfo = document.getElementById(\"detalle-tercero-info\")?.innerText || \"\";\r\n\r\n      const formas = hojaPreview.shapes;\r\n\r\n      const textBoxTitulo = formas.addTextBox();\r\n      textBoxTitulo.left = 40;\r\n      textBoxTitulo.top = 20;\r\n      textBoxTitulo.width = 470;\r\n      textBoxTitulo.height = 32;\r\n      textBoxTitulo.textFrame.textRange.text = tituloReporte;\r\n      textBoxTitulo.textFrame.textRange.font.size = 14;\r\n      textBoxTitulo.textFrame.textRange.font.bold = true;\r\n      textBoxTitulo.textFrame.textRange.font.color = \"#005a9e\";\r\n      textBoxTitulo.lineFormat.color = \"#d1d1d1\";\r\n\r\n      const titleEmisor = formas.addTextBox();\r\n      titleEmisor.left = 40;\r\n      titleEmisor.top = 62;\r\n      titleEmisor.width = 230;\r\n      titleEmisor.height = 22;\r\n      titleEmisor.textFrame.textRange.text = \"EMISOR\";\r\n      titleEmisor.textFrame.textRange.font.size = 10;\r\n      titleEmisor.textFrame.textRange.font.bold = true;\r\n      titleEmisor.textFrame.textRange.font.color = \"#005a9e\";\r\n      titleEmisor.lineFormat.color = \"#d1d1d1\";\r\n\r\n      const textBoxEmisor = formas.addTextBox();\r\n      textBoxEmisor.left = 40;\r\n      textBoxEmisor.top = 83;\r\n      textBoxEmisor.width = 230;\r\n      textBoxEmisor.height = 80;\r\n      textBoxEmisor.textFrame.textRange.text = empresaInfo;\r\n      textBoxEmisor.textFrame.textRange.font.size = 9.5;\r\n      textBoxEmisor.textFrame.textRange.font.color = \"#333333\";\r\n      textBoxEmisor.lineFormat.color = \"#d1d1d1\";\r\n\r\n      const titleTercero = formas.addTextBox();\r\n      titleTercero.left = 280;\r\n      titleTercero.top = 62;\r\n      titleTercero.width = 230;\r\n      titleTercero.height = 22;\r\n      titleTercero.textFrame.textRange.text = terceroTitulo.toUpperCase();\r\n      titleTercero.textFrame.textRange.font.size = 10;\r\n      titleTercero.textFrame.textRange.font.bold = true;\r\n      titleTercero.textFrame.textRange.font.color = \"#005a9e\";\r\n      titleTercero.lineFormat.color = \"#d1d1d1\";\r\n\r\n      const textBoxTercero = formas.addTextBox();\r\n      textBoxTercero.left = 280;\r\n      textBoxTercero.top = 83;\r\n      textBoxTercero.width = 230;\r\n      textBoxTercero.height = 80;\r\n      textBoxTercero.textFrame.textRange.text = terceroInfo;\r\n      textBoxTercero.textFrame.textRange.font.size = 9.5;\r\n      textBoxTercero.textFrame.textRange.font.color = \"#333333\";\r\n      textBoxTercero.lineFormat.color = \"#d1d1d1\";\r\n\r\n      const rangoCabecera = hojaPreview.getRange(\"B13:G13\");\r\n      rangoCabecera.values = [[\"ID Factura\", \"Fecha Cobro\", \"Forma Pago\", \"Importe\", \"Observaciones\", \"Usuario\"]];\r\n      rangoCabecera.format.font.bold = true;\r\n      rangoCabecera.format.font.color = \"white\";\r\n      rangoCabecera.format.fill.color = \"#005a9e\";\r\n      rangoCabecera.format.horizontalAlignment = \"Center\";\r\n\r\n      const filas = document.querySelectorAll(\"#detalle-tabla-registros tr\");\r\n      let filaActual = 14;\r\n\r\n      filas.forEach((tr) => {\r\n        const cols = tr.querySelectorAll(\"td\");\r\n        if (cols.length >= 6) {\r\n          const rangoFila = hojaPreview.getRange(`B${filaActual}:G${filaActual}`);\r\n          rangoFila.values = [\r\n            [\r\n              cols[0].innerText.trim(),\r\n              cols[1].innerText,\r\n              cols[2].innerText,\r\n              cols[3].innerText,\r\n              cols[4].innerText,\r\n              cols[5].innerText,\r\n            ],\r\n          ];\r\n\r\n          hojaPreview.getRange(`B${filaActual}`).format.horizontalAlignment = \"Center\";\r\n          hojaPreview.getRange(`C${filaActual}`).format.horizontalAlignment = \"Center\";\r\n          hojaPreview.getRange(`D${filaActual}`).format.horizontalAlignment = \"Left\";\r\n          hojaPreview.getRange(`E${filaActual}`).format.horizontalAlignment = \"Right\";\r\n          hojaPreview.getRange(`F${filaActual}`).format.horizontalAlignment = \"Left\";\r\n          hojaPreview.getRange(`G${filaActual}`).format.horizontalAlignment = \"Center\";\r\n\r\n          filaActual++;\r\n        }\r\n      });\r\n\r\n      if (filaActual > 14) {\r\n        const tablaCompleta = hojaPreview.getRange(`B13:G${filaActual - 1}`);\r\n        tablaCompleta.format.borders.getItem(\"EdgeTop\").style = \"Continuous\";\r\n        tablaCompleta.format.borders.getItem(\"EdgeBottom\").style = \"Continuous\";\r\n        tablaCompleta.format.borders.getItem(\"EdgeLeft\").style = \"Continuous\";\r\n        tablaCompleta.format.borders.getItem(\"EdgeRight\").style = \"Continuous\";\r\n        tablaCompleta.format.borders.getItem(\"InsideHorizontal\").style = \"Continuous\";\r\n        tablaCompleta.format.borders.getItem(\"InsideVertical\").style = \"Continuous\";\r\n        tablaCompleta.format.borders.getItem(\"InsideHorizontal\").color = \"#d1d1d1\";\r\n        tablaCompleta.format.borders.getItem(\"InsideVertical\").color = \"#d1d1d1\";\r\n      }\r\n\r\n      await context.sync();\r\n      cerrarDetalleFactura();\r\n      alert(`¡Hoja '${nombreHoja}' generada con éxito!`);\r\n    });\r\n  } catch (error) {\r\n    console.error(\"Error al crear la hoja:\", error);\r\n    alert(\"Ocurrió un error al generar la hoja. Revisa la consola.\");\r\n  }\r\n};\r\n"
  language: typescript
