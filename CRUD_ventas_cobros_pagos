   const rangeEmpresa = sheetEmpresa.getUsedRange();\r\n      rangeEmpresa.load(\"values\");\r\n      await context.sync();\r\n\r\n      const valsEmpresa = rangeEmpresa.values as (string | number)[][];\r\n      if (valsEmpresa && valsEmpresa.length > 1) {\r\n        const rowEmp = valsEmpresa[1];\r\n        infoEmpresa.innerHTML = `\r\n          <strong>${rowEmp[1] || \"\"}</strong><br>\r\n          ${rowEmp[2] || \"\"}<br>\r\n          ${rowEmp[3] || \"\"} ${rowEmp[4] || \"\"}<br>\r\n          ${rowEmp[5] || \"\"} (${rowEmp[6] || \"\"})<br>\r\n          Tel: ${rowEmp[7] || \"\"}\r\n        `;\r\n      } else {\r\n        infoEmpresa.innerHTML = \"No se encontraron datos en la hoja Empresa.\";\r\n      }\r\n\r\n      if (tipo === \"venta\") {\r\n        tituloTercero.textContent = \"CLIENTE / COBROS\";\r\n        tablaRegistros.innerHTML = \"\";\r\n        let encontrados = 0;\r\n        let numClienteAsociado = \"\";\r\n\r\n        for (let i = 1; i < datosCacheCobrosVentas.length; i++) {\r\n          const row = datosCacheCobrosVentas[i];\r\n          if (row && row[0]) {\r\n            const idFac = String(row[0] || \"\");\r\n            const numCli = String(row[1] || \"\");\r\n            const fechaCobro = formatearFechaExcel(row[2]);\r\n            const importe = String(row[3] || \"\");\r\n            const formaPago = String(row[4] || \"\");\r\n            const obs = String(row[5] || \"\");\r\n            const logUser = String(row[6] || \"\");\r\n\r\n            if (idFac === valorBusqueda || numCli === valorBusqueda) {\r\n              encontrados++;\r\n              numClienteAsociado = numCli;\r\n              const tr = document.createElement(\"tr\");\r\n              tr.innerHTML = `\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: right;\">${idFac}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${fechaCobro}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd;\">${formaPago}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: right;\">${importe} €</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd;\">${obs}</td>\r\n                <td style=\"padding: 3px; border: 1px solid #ddd; text-align: center;\">${logUser}</td>\r\n              `;\r\n              tablaRegistros.appendChild(tr);\r\n            }\r\n          }\r\n        }\r\n\r\n        if (numClienteAsociado) {\r\n          const sheetCli = context.workbook.worksheets.getItem(\"Clientes\");\r\n          const rangeCli = sheetCli.getUsedRange();\r\n          rangeCli.load(\"values\");\r\n          await context.sync();\r\n          const dataCli = rangeCli.values as (string | number)[][];\r\n          let cliRow: (string | number)[] = [];\r\n          for (let i = 1; i < dataCli.length; i++) {\r\n            if (String(dataCli[i][0]).trim() === numClienteAsociado) {\r\n              cliRow = dataCli[i];\r\n              break;\r\n            }\r\n          }\r\n          if (cliRow.length > 0) {\r\n            infoTercero.innerHTML = `\r\n              <strong>Nº ${cliRow[0]} - ${cliRow[1] || \"\"}</strong><br>\r\n              DNI: ${cliRow[2] || \"\"}<br>\r\n              ${cliRow[4] || \"\"}, ${cliRow[3] || \"\"} ${cliRow[5] || \"\"}<br>\r\n              Tel: ${cliRow[7] || \"\"}\r\n            `;\r\n          } else {\r\n            infoTercero.innerHTML = `Cliente nº ${numClienteAsociado}`;\r\n          }\r\n        } else {\r\n          infoTercero.innerHTML = `No se encontró información para el filtro \"${valorBusqueda}\".`;\r\n        }\r\n\r\n        if (encontrados === 0) {\r\n          tablaRegistros.innerHTML = `<tr><td colspan=\"6\" style=\"text-align:center; padding: 8px; color: #666;\">No hay historial de cobros para este filtro.</td></tr>`;\r\n        }\r\n      } else {\r\n        tituloTercero.textContent = \"PROVEEDOR / PAGOS\";\r\n        tablaRegistros.innerHTML = \"\";\r\n   