name: 🛒 MisCuentas 2
description: |-
  Incluye login
  Incluye cobros
host: EXCEL
api_set: {}
script:
  content: "let datosCache: (string | number)[][] = [];\r\nlet datosCacheProv: (string | number)[][] = [];\r\nlet datosCacheFacturas: (string | number)[][] = [];\r\nlet datosCacheCompras: (string | number)[][] = [];\r\nlet datosCacheCobrosVentas: (string | number)[][] = [];\r\nlet datosCachePagosCompras: (string | number)[][] = [];\r\n\r\nlet mapaClientesNombres: { [key: string]: string } = {};\r\nlet mapaProveedoresNombres: { [key: string]: string } = {};\r\nlet formasPagoPersonalizadas: string[] = [\"TARJETA\"];\r\nlet formasPagoFijas: string[] = [\"CONTADO\", \"GIRO 30\", \"GIRO 60\", \"GIRO 85\", \"TRANSFERENCIA\", \"BIZUM\"];\r\nlet tipoModalActual: \"venta\" | \"compra\" = \"venta\";\r\n\r\n// ==========================================\r\n// CONFIGURACIÓN DE USUARIOS AUTORIZADOS (LOGIN SEGURO)\r\n// ==========================================\r\nconst USUARIOS_AUTORIZADOS: { [usuario: string]: string } = {\r\n  ADMIN: \"abcd\",\r\n  BENITO: \"1234\",\r\n  MARIA: \"pass789\",\r\n};\r\nlet usuarioActual: string = \"\";\r\n\r\nfunction mostrarModalLogin() {\r\n  const modal = document.getElementById(\"modal-login\");\r\n  if (modal) modal.style.display = \"flex\";\r\n}\r\n\r\nfunction validarLogin() {\r\n  const inputUser = (document.getElementById(\"login-user\") as HTMLInputElement).value.trim().toUpperCase();\r\n  const inputPass = (document.getElementById(\"login-pass\") as HTMLInputElement).value.trim();\r\n  const errorLabel = document.getElementById(\"login-error-msg\");\r\n\r\n  if (USUARIOS_AUTORIZADOS[inputUser] && USUARIOS_AUTORIZADOS[inputUser] === inputPass) {\r\n    usuarioActual = inputUser;\r\n    if (errorLabel) errorLabel.style.display = \"none\";\r\n    const modal = document.getElementById(\"modal-login\");\r\n    if (modal) modal.style.display = \"none\";\r\n\r\n    const lblVentas = document.getElementById(\"user-label-ventas\");\r\n    const lblCompras = document.getElementById(\"user-label-compras\");\r\n    if (lblVentas) lblVentas.textContent = `🟢 Usuario: ${usuarioActual}`;\r\n    if (lblCompras) lblCompras.textContent = `🟢 Usuario: ${usuarioActual}`;\r\n  } else {\r\n    if (errorLabel) {\r\n      errorLabel.style.display = \"block\";\r\n      errorLabel.textContent = \"❌ Usuario o contraseña incorrectos.\";\r\n    }\r\n  }\r\n}\r\n\r\nfunction soloNumeros(e: KeyboardEvent): boolean {\r\n  const charCode = e.which ? e.which : e.keyCode;\r\n  if (charCode < 48 || charCode > 57) {\r\n    e.preventDefault();\r\n    return false;\r\n  }\r\n  return true;\r\n}\r\n\r\nfunction toggleSubmenu(event: Event, submenuId: string, iconId: string) {\r\n  event.preventDefault();\r\n  const submenu = document.getElementById(submenuId);\r\n  const icon = document.getElementById(iconId);\r\n  if (submenu && icon) {\r\n    submenu.classList.toggle(\"open\");\r\n    icon.classList.toggle(\"rotate\");\r\n  }\r\n}\r\n\r\nfunction mostrarVista(nombreVista: string) {\r\n  const paneles = document.querySelectorAll(\".vista-panel\");\r\n  paneles.forEach((panel) => panel.classList.remove(\"active\"));\r\n\r\n  const vistaActiva = document.getElementById(`vista-${nombreVista}`);\r\n  if (vistaActiva) {\r\n    vistaActiva.classList.add(\"active\");\r\n  }\r\n\r\n  if (nombreVista === \"clientes\") {\r\n    cargarTablaClientes();\r\n  } else if (nombreVista === \"proveedores\") {\r\n    cargarTablaProveedores();\r\n  } else if (nombreVista === \"facturas_ventas\") {\r\n    actualizarSelectsFormasPago();\r\n    cargarClientesParaSelect();\r\n    cargarTablaFacturas();\r\n  } else if (nombreVista === \"facturas_compras\") {\r\n    actualizarSelectsFormasPago();\r\n    cargarProveedoresParaSelect();\r\n    cargarTablaCompras();\r\n  } else if (nombreVista === \"pagos_clientes\") {\r\n    cargarHistorialCobrosVentas();\r\n  } else if (nombreVista === \"pagos_proveedores\") {\r\n    cargarHistorialPagosCompras();\r\n  }\r\n}\r\n\r\n// ==========================================\r\n// CRUD CLIENTES\r\n// ==========================================\r\nasync function guardarCliente() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Clientes\");\r\n    const datos = obtenerValoresFormulario();\r\n\r\n    if (!datos.numCliente) {\r\n      alert(\"El número de cliente es obligatorio.\");\r\n      return;\r\n    }\r\n\r\n    const usedRange = sheet.getUsedRange();\r\n    usedRange.load(\"rowCount\");\r\n    await context.sync();\r\n\r\n    escribirFila(sheet, usedRange.rowCount, datos);\r\n    await context.sync();\r\n    alert(\"¡Cliente guardado correctamente!\");\r\n    limpiarFormulario();\r\n    await cargarTablaClientes();\r\n  });\r\n}\r\n\r\nasync function actualizarCliente() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Clientes\");\r\n    const datos = obtenerValoresFormulario();\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === datos.numCliente) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"No se encontró el cliente.\");\r\n      return;\r\n    }\r\n\r\n    escribirFila(sheet, rowIndex, datos);\r\n    await context.sync();\r\n    alert(\"¡Cliente actualizado correctamente!\");\r\n    limpiarFormulario();\r\n    await cargarTablaClientes();\r\n  });\r\n}\r\n\r\nasync function eliminarCliente() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Clientes\");\r\n    const numClienteInput = document.getElementById(\"num_cliente\") as HTMLInputElement;\r\n    if (!numClienteInput) return;\r\n    const numCliente = numClienteInput.value.trim();\r\n\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === numCliente) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"Cliente no encontrado.\");\r\n      return;\r\n    }\r\n\r\n    sheet.getRangeByIndexes(rowIndex, 0, 1, 9).delete(Excel.DeleteShiftDirection.up);\r\n    await context.sync();\r\n    alert(\"Cliente eliminado.\");\r\n    limpiarFormulario();\r\n    await cargarTablaClientes();\r\n  });\r\n}\r\n\r\nasync function cargarTablaClientes() {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const sheet = context.workbook.worksheets.getItem(\"Clientes\");\r\n      const range = sheet.getUsedRange();\r\n      range.load(\"values\");\r\n      await context.sync();\r\n\r\n      datosCache = range.values as (string | number)[][];\r\n\r\n      mapaClientesNombres = {};\r\n      for (let i = 1; i < datosCache.length; i++) {\r\n        const row = datosCache[i];\r\n        if (row && row[0]) {\r\n          mapaClientesNombres[String(row[0]).trim()] = String(row[1] || \"\").trim();\r\n        }\r\n      }\r\n\r\n      renderizarTabla(datosCache);\r\n      generarSiguienteIdCliente(datosCache);\r\n    });\r\n  } catch (e) {\r\n    console.log(\"Esperando datos de Clientes...\");\r\n  }\r\n}\r\n\r\nfunction generarSiguienteIdCliente(data: (string | number)[][]) {\r\n  let maxId = 0;\r\n  for (let i = 1; i < data.length; i++) {\r\n    const val = parseInt(String(data[i][0] || \"0\"), 10);\r\n    if (!isNaN(val) && val > maxId) maxId = val;\r\n  }\r\n  const inputNum = document.getElementById(\"num_cliente\") as HTMLInputElement;\r\n  if (inputNum && !inputNum.disabled) {\r\n    inputNum.value = String(maxId + 1).padStart(5, \"0\");\r\n  }\r\n}\r\n\r\nfunction renderizarTabla(data: (string | number)[][], filtro: string = \"\") {\r\n  const tbody = document.getElementById(\"tbody-clientes\");\r\n  if (!tbody) return;\r\n  tbody.innerHTML = \"\";\r\n  const filtroTexto = filtro.toLowerCase();\r\n\r\n  for (let i = 1; i < data.length; i++) {\r\n    const row = data[i];\r\n    if (row && row[0]) {\r\n      const numC = String(row[0] || \"\");\r\n      const nombre = String(row[1] || \"\").toLowerCase();\r\n      const dni = String(row[2] || \"\").toLowerCase();\r\n      const telefono = String(row[7] || \"\");\r\n      const activo = String(row[8] || \"\");\r\n\r\n      if (filtroTexto && !nombre.includes(filtroTexto) && !dni.includes(filtroTexto) && !numC.includes(filtroTexto))\r\n        continue;\r\n\r\n      const tr = document.createElement(\"tr\");\r\n      tr.innerHTML = `\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${numC}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4;\">${row[1] || \"\"}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${telefono}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${activo}</td>\r\n      `;\r\n      tr.onclick = () => seleccionarClienteFila(row);\r\n      tbody.appendChild(tr);\r\n    }\r\n  }\r\n}\r\n\r\nfunction seleccionarClienteFila(row: (string | number)[]) {\r\n  const setVal = (id: string, val: string) => {\r\n    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;\r\n    if (el) el.value = val;\r\n  };\r\n\r\n  setVal(\"num_cliente\", String(row[0] || \"\"));\r\n  setVal(\"nombre\", String(row[1] || \"\"));\r\n  setVal(\"dni\", String(row[2] || \"\"));\r\n  setVal(\"codigo_postal\", String(row[3] || \"\"));\r\n  setVal(\"direccion\", String(row[4] || \"\"));\r\n  setVal(\"provincia\", String(row[5] || \"\"));\r\n  setVal(\"pais\", String(row[6] || \"\"));\r\n  setVal(\"telefono\", String(row[7] || \"\"));\r\n  setVal(\"activo\", String(row[8] || \"VERDADERO\"));\r\n\r\n  document.getElementById(\"btn-guardar\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-actualizar\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-eliminar\")!.style.display = \"inline-flex\";\r\n  (document.getElementById(\"num_cliente\") as HTMLInputElement).disabled = true;\r\n}\r\n\r\nfunction limpiarFormulario() {\r\n  document.querySelectorAll(\"#vista-clientes input\").forEach((input) => {\r\n    const el = input as HTMLInputElement;\r\n    if (el.id !== \"buscador\") {\r\n      el.value = \"\";\r\n      el.disabled = false;\r\n    }\r\n  });\r\n  (document.getElementById(\"activo\") as HTMLSelectElement).value = \"VERDADERO\";\r\n  document.getElementById(\"btn-guardar\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-actualizar\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-eliminar\")!.style.display = \"none\";\r\n  generarSiguienteIdCliente(datosCache);\r\n}\r\n\r\nfunction obtenerValoresFormulario() {\r\n  const getVal = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || \"\";\r\n  return {\r\n    numCliente: getVal(\"num_cliente\"),\r\n    nombre: getVal(\"nombre\"),\r\n    dni: getVal(\"dni\"),\r\n    cp: getVal(\"codigo_postal\"),\r\n    direccion: getVal(\"direccion\"),\r\n    provincia: getVal(\"provincia\"),\r\n    pais: getVal(\"pais\"),\r\n    telefono: getVal(\"telefono\"),\r\n    activo: getVal(\"activo\"),\r\n  };\r\n}\r\n\r\nfunction escribirFila(sheet: Excel.Worksheet, rowIndex: number, datos: any) {\r\n  sheet.getCell(rowIndex, 0).values = [[datos.numCliente]];\r\n  sheet.getCell(rowIndex, 1).values = [[datos.nombre]];\r\n  sheet.getCell(rowIndex, 2).values = [[datos.dni]];\r\n  sheet.getCell(rowIndex, 3).values = [[datos.cp]];\r\n  sheet.getCell(rowIndex, 4).values = [[datos.direccion]];\r\n  sheet.getCell(rowIndex, 5).values = [[datos.provincia]];\r\n  sheet.getCell(rowIndex, 6).values = [[datos.pais]];\r\n  sheet.getCell(rowIndex, 7).values = [[datos.telefono]];\r\n  sheet.getCell(rowIndex, 8).values = [[datos.activo]];\r\n}\r\n\r\n// ==========================================\r\n// CRUD PROVEEDORES\r\n// ==========================================\r\nasync function guardarProveedor() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Proveedores\");\r\n    const datos = obtenerValoresFormularioProv();\r\n    if (!datos.numProv) {\r\n      alert(\"El número de proveedor es obligatorio.\");\r\n      return;\r\n    }\r\n\r\n    const usedRange = sheet.getUsedRange();\r\n    usedRange.load(\"rowCount\");\r\n    await context.sync();\r\n\r\n    escribirFilaProv(sheet, usedRange.rowCount, datos);\r\n    await context.sync();\r\n    alert(\"¡Proveedor guardado correctamente!\");\r\n    limpiarFormularioProv();\r\n    await cargarTablaProveedores();\r\n  });\r\n}\r\n\r\nasync function actualizarProveedor() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Proveedores\");\r\n    const datos = obtenerValoresFormularioProv();\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === datos.numProv) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"No se encontró el proveedor.\");\r\n      return;\r\n    }\r\n\r\n    escribirFilaProv(sheet, rowIndex, datos);\r\n    await context.sync();\r\n    alert(\"¡Proveedor actualizado correctamente!\");\r\n    limpiarFormularioProv();\r\n    await cargarTablaProveedores();\r\n  });\r\n}\r\n\r\nasync function eliminarProveedor() {\r\n  await Excel.run(async (context) => {\r\n    const sheet = context.workbook.worksheets.getItem(\"Proveedores\");\r\n    const numInput = document.getElementById(\"num_prov\") as HTMLInputElement;\r\n    if (!numInput) return;\r\n    const numProv = numInput.value.trim();\r\n\r\n    const range = sheet.getRange(\"A:A\");\r\n    range.load(\"text\");\r\n    await context.sync();\r\n\r\n    let rowIndex = -1;\r\n    const values = range.text;\r\n    for (let i = 0; i < values.length; i++) {\r\n      if (values[i][0] === numProv) {\r\n        rowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (rowIndex === -1) {\r\n      alert(\"Proveedor no encontrado.\");\r\n      return;\r\n    }\r\n\r\n    sheet.getRangeByIndexes(rowIndex, 0, 1, 9).delete(Excel.DeleteShiftDirection.up);\r\n    await context.sync();\r\n    alert(\"Proveedor eliminado.\");\r\n    limpiarFormularioProv();\r\n    await cargarTablaProveedores();\r\n  });\r\n}\r\n\r\nasync function cargarTablaProveedores() {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const sheet = context.workbook.worksheets.getItem(\"Proveedores\");\r\n      const range = sheet.getUsedRange();\r\n      range.load(\"values\");\r\n      await context.sync();\r\n\r\n      datosCacheProv = range.values as (string | number)[][];\r\n\r\n      mapaProveedoresNombres = {};\r\n      for (let i = 1; i < datosCacheProv.length; i++) {\r\n        const row = datosCacheProv[i];\r\n        if (row && row[0]) {\r\n          mapaProveedoresNombres[String(row[0]).trim()] = String(row[1] || \"\").trim();\r\n        }\r\n      }\r\n\r\n      renderizarTablaProv(datosCacheProv);\r\n      generarSiguienteIdProv(datosCacheProv);\r\n    });\r\n  } catch (e) {\r\n    console.log(\"Esperando datos de Proveedores...\");\r\n  }\r\n}\r\n\r\nfunction generarSiguienteIdProv(data: (string | number)[][]) {\r\n  let maxId = 0;\r\n  for (let i = 1; i < data.length; i++) {\r\n    const val = parseInt(String(data[i][0] || \"0\"), 10);\r\n    if (!isNaN(val) && val > maxId) maxId = val;\r\n  }\r\n  const inputNum = document.getElementById(\"num_prov\") as HTMLInputElement;\r\n  if (inputNum && !inputNum.disabled) {\r\n    inputNum.value = String(maxId + 1).padStart(5, \"0\");\r\n  }\r\n}\r\n\r\nfunction renderizarTablaProv(data: (string | number)[][], filtro: string = \"\") {\r\n  const tbody = document.getElementById(\"tbody-proveedores\");\r\n  if (!tbody) return;\r\n  tbody.innerHTML = \"\";\r\n  const filtroTexto = filtro.toLowerCase();\r\n\r\n  for (let i = 1; i < data.length; i++) {\r\n    const row = data[i];\r\n    if (row && row[0]) {\r\n      const numP = String(row[0] || \"\");\r\n      const nombre = String(row[1] || \"\").toLowerCase();\r\n      const dniCif = String(row[2] || \"\").toLowerCase();\r\n      const telefono = String(row[7] || \"\");\r\n      const activo = String(row[8] || \"\");\r\n\r\n      if (filtroTexto && !nombre.includes(filtroTexto) && !dniCif.includes(filtroTexto) && !numP.includes(filtroTexto))\r\n        continue;\r\n\r\n      const tr = document.createElement(\"tr\");\r\n      tr.innerHTML = `\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${numP}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4;\">${row[1] || \"\"}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${telefono}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${activo}</td>\r\n      `;\r\n      tr.onclick = () => seleccionarProveedorFila(row);\r\n      tbody.appendChild(tr);\r\n    }\r\n  }\r\n}\r\n\r\nfunction seleccionarProveedorFila(row: (string | number)[]) {\r\n  const setVal = (id: string, val: string) => {\r\n    const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement;\r\n    if (el) el.value = val;\r\n  };\r\n  setVal(\"num_prov\", String(row[0] || \"\"));\r\n  setVal(\"nombre_prov\", String(row[1] || \"\"));\r\n  setVal(\"dni_cif_prov\", String(row[2] || \"\"));\r\n  setVal(\"codigo_postal_prov\", String(row[3] || \"\"));\r\n  setVal(\"direccion_prov\", String(row[4] || \"\"));\r\n  setVal(\"provincia_prov\", String(row[5] || \"\"));\r\n  setVal(\"pais_prov\", String(row[6] || \"\"));\r\n  setVal(\"telefono_prov\", String(row[7] || \"\"));\r\n  setVal(\"activo_prov\", String(row[8] || \"VERDADERO\"));\r\n\r\n  document.getElementById(\"btn-guardar-prov\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-actualizar-prov\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-eliminar-prov\")!.style.display = \"inline-flex\";\r\n  (document.getElementById(\"num_prov\") as HTMLInputElement).disabled = true;\r\n}\r\n\r\nfunction limpiarFormularioProv() {\r\n  document.querySelectorAll(\"#vista-proveedores input\").forEach((input) => {\r\n    const el = input as HTMLInputElement;\r\n    if (el.id !== \"buscador_prov\") {\r\n      el.value = \"\";\r\n      el.disabled = false;\r\n    }\r\n  });\r\n  (document.getElementById(\"activo_prov\") as HTMLSelectElement).value = \"VERDADERO\";\r\n  document.getElementById(\"btn-guardar-prov\")!.style.display = \"inline-flex\";\r\n  document.getElementById(\"btn-actualizar-prov\")!.style.display = \"none\";\r\n  document.getElementById(\"btn-eliminar-prov\")!.style.display = \"none\";\r\n  generarSiguienteIdProv(datosCacheProv);\r\n}\r\n\r\nfunction obtenerValoresFormularioProv() {\r\n  const getVal = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value.trim() || \"\";\r\n  return {\r\n    numProv: getVal(\"num_prov\"),\r\n    nombre: getVal(\"nombre_prov\"),\r\n    dni: getVal(\"dni_cif_prov\"),\r\n    cp: getVal(\"codigo_postal_prov\"),\r\n    direccion: getVal(\"direccion_prov\"),\r\n    provincia: getVal(\"provincia_prov\"),\r\n    pais: getVal(\"pais_prov\"),\r\n    telefono: getVal(\"telefono_prov\"),\r\n    activo: getVal(\"activo_prov\"),\r\n  };\r\n}\r\n\r\nfunction escribirFilaProv(sheet: Excel.Worksheet, rowIndex: number, datos: any) {\r\n  sheet.getCell(rowIndex, 0).values = [[datos.numProv]];\r\n  sheet.getCell(rowIndex, 1).values = [[datos.nombre]];\r\n  sheet.getCell(rowIndex, 2).values = [[datos.dni]];\r\n  sheet.getCell(rowIndex, 3).values = [[datos.cp]];\r\n  sheet.getCell(rowIndex, 4).values = [[datos.direccion]];\r\n  sheet.getCell(rowIndex, 5).values = [[datos.provincia]];\r\n  sheet.getCell(rowIndex, 6).values = [[datos.pais]];\r\n  sheet.getCell(rowIndex, 7).values = [[datos.telefono]];\r\n  sheet.getCell(rowIndex, 8).values = [[datos.activo]];\r\n}\r\n\r\n// ==========================================\r\n// GESTIÓN DE MODALES FLOTANTES\r\n// ==========================================\r\nfunction abrirModalTercero(tipo: \"cliente\" | \"proveedor\", selectEl: HTMLSelectElement) {\r\n  const modal = document.getElementById(\"modal-tercero\");\r\n  const titulo = document.getElementById(\"modal-tercero-titulo\");\r\n  const inputNombre = document.getElementById(\"input-modal-nombre\") as HTMLInputElement;\r\n  if (!modal || !titulo || !inputNombre) return;\r\n\r\n  inputNombre.value = \"\";\r\n  titulo.innerHTML =\r\n    tipo === \"cliente\"\r\n      ? '<i class=\"bi bi-person-plus-fill\"></i> Añadir Nuevo Cliente'\r\n      : '<i class=\"bi bi-building-add\"></i> Añadir Nuevo Proveedor';\r\n  modal.style.display = \"flex\";\r\n  inputNombre.focus();\r\n\r\n  const btnOk = document.getElementById(\"btn-modal-tercero-ok\");\r\n  const btnCancel = document.getElementById(\"btn-modal-tercero-cancel\");\r\n\r\n  const limpiarEventos = () => {\r\n    btnOk?.replaceWith(btnOk.cloneNode(true));\r\n    btnCancel?.replaceWith(btnCancel.cloneNode(true));\r\n    inputNombre.onkeydown = null;\r\n  };\r\n\r\n  const ejecutarAccion = async () => {\r\n    const nombreVal = inputNombre.value.trim();\r\n    if (nombreVal) {\r\n      modal.style.display = \"none\";\r\n      limpiarEventos();\r\n      if (tipo === \"cliente\") {\r\n        await guardarClienteRapido(nombreVal, selectEl);\r\n      } else {\r\n        await guardarProveedorRapido(nombreVal, selectEl);\r\n      }\r\n    } else {\r\n      alert(\"Introduce un nombre válido.\");\r\n    }\r\n  };\r\n\r\n  document.getElementById(\"btn-modal-tercero-ok\")?.addEventListener(\"click\", ejecutarAccion);\r\n\r\n  inputNombre.onkeydown = async (e) => {\r\n    if (e.key === \"Enter\") {\r\n      e.preventDefault();\r\n      await ejecutarAccion();\r\n    }\r\n  };\r\n\r\n  document.getElementById(\"btn-modal-tercero-cancel\")?.addEventListener(\"click\", () => {\r\n    modal.style.display = \"none\";\r\n    selectEl.value = \"\";\r\n    limpiarEventos();\r\n  });\r\n}\r\n\r\nfunction abrirModalPago(selectEl: HTMLSelectElement) {\r\n  const modal = document.getElementById(\"modal-pago\");\r\n  const inputPago = document.getElementById(\"input-modal-pago\") as HTMLInputElement;\r\n  if (!modal || !inputPago) return;\r\n\r\n  inputPago.value = \"\";\r\n  modal.style.display = \"flex\";\r\n  inputPago.focus();\r\n\r\n  const btnOk = document.getElementById(\"btn-modal-pago-ok\");\r\n  const btnCancel = document.getElementById(\"btn-modal-pago-cancel\");\r\n\r\n  const limpiarEventos = () => {\r\n    btnOk?.replaceWith(btnOk.cloneNode(true));\r\n    btnCancel?.replaceWith(btnCancel.cloneNode(true));\r\n    inputPago.onkeydown = null;\r\n  };\r\n\r\n  const ejecutarAccion = () => {\r\n    const pagoVal = inputPago.value.trim().toUpperCase();\r\n    if (pagoVal) {\r\n      modal.style.display = \"none\";\r\n      limpiarEventos();\r\n\r\n      if (!formasPagoPersonalizadas.includes(pagoVal)) {\r\n        formasPagoPersonalizadas.push(pagoVal);\r\n      }\r\n\r\n      actualizarSelectsFormasPago();\r\n      selectEl.value = pagoVal;\r\n      procesarFormaPagoYFechas();\r\n      procesarFormaPagoYFechasCompra();\r\n    } else {\r\n      alert(\"Introduce una descripción válida.\");\r\n    }\r\n  };\r\n\r\n  document.getElementById(\"btn-modal-pago-ok\")?.addEventListener(\"click\", ejecutarAccion);\r\n\r\n  inputPago.onkeydown = (e) => {\r\n    if (e.key === \"Enter\") {\r\n      e.preventDefault();\r\n      ejecutarAccion();\r\n    }\r\n  };\r\n\r\n  document.getElementById(\"btn-modal-pago-cancel\")?.addEventListener(\"click\", () => {\r\n    modal.style.display = \"none\";\r\n    limpiarEventos();\r\n  });\r\n}\r\n\r\nfunction abrirModalEliminarPago(selectEl: HTMLSelectElement) {\r\n  const modal = document.getElementById(\"modal-eliminar-pago\");\r\n  const contenedorLista = document.getElementById(\"lista-formas-pago-eliminar\");\r\n  if (!modal || !contenedorLista) return;\r\n\r\n  contenedorLista.innerHTML = \"\";\r\n  const todasLasFormasPago = [...formasPagoFijas, ...formasPagoPersonalizadas];\r\n\r\n  if (todasLasFormasPago.length === 0) {\r\n    alert(\"No hay formas de pago disponibles para eliminar.\");\r\n    selectEl.value = \"\";\r\n    return;\r\n  }\r\n\r\n  todasLasFormasPago.forEach((pago) => {\r\n    const fila = document.createElement(\"div\");\r\n    fila.className = \"fila-item-pago\";\r\n    fila.innerHTML = `\r\n      <span><i class=\"bi bi-tag-fill\"></i> ${pago}</span>\r\n      <button type=\"button\" class=\"btn-borrar-pago\"><i class=\"bi bi-trash\"></i> Eliminar</button>\r\n    `;\r\n\r\n    fila.querySelector(\"button\")?.addEventListener(\"click\", () => {\r\n      if (formasPagoPersonalizadas.includes(pago)) {\r\n        formasPagoPersonalizadas = formasPagoPersonalizadas.filter((p) => p !== pago);\r\n      } else if (formasPagoFijas.includes(pago)) {\r\n        const index = formasPagoFijas.indexOf(pago);\r\n        if (index > -1) formasPagoFijas.splice(index, 1);\r\n      }\r\n\r\n      actualizarSelectsFormasPago();\r\n      modal.style.display = \"none\";\r\n      selectEl.value = \"\";\r\n      alert(`Forma de pago \"${pago}\" eliminada correctamente.`);\r\n    });\r\n\r\n    contenedorLista.appendChild(fila);\r\n  });\r\n\r\n  modal.style.display = \"flex\";\r\n\r\n  const btnCancel = document.getElementById(\"btn-modal-del-cancel\");\r\n  const limpiarEventos = () => {\r\n    btnCancel?.replaceWith(btnCancel.cloneNode(true));\r\n  };\r\n\r\n  document.getElementById(\"btn-modal-del-cancel\")?.addEventListener(\"click\", () => {\r\n    modal.style.display = \"none\";\r\n    selectEl.value = \"\";\r\n    limpiarEventos();\r\n  });\r\n}\r\n\r\nfunction actualizarSelectsFormasPago() {\r\n  [\"fac_forma_pago\", \"com_forma_pago\", \"cobro_forma_pago\", \"pago_prov_forma_pago\"].forEach((id) => {\r\n    const sel = document.getElementById(id) as HTMLSelectElement;\r\n    if (!sel) return;\r\n    const valorActual = sel.value;\r\n\r\n    let htmlOpciones = '<option value=\"\">-- Seleccione forma de pago --</option>';\r\n    formasPagoFijas.forEach((pago) => {\r\n      htmlOpciones += `<option value=\"${pago}\">${pago}</option>`;\r\n    });\r\n    formasPagoPersonalizadas.forEach((pago) => {\r\n      htmlOpciones += `<option value=\"${pago}\">${pago}</option>`;\r\n    });\r\n    if (id === \"fac_forma_pago\" || id === \"com_forma_pago\") {\r\n      htmlOpciones += `\r\n        <option value=\"OTRA\">➕ [ OTRA FORMA DE PAGO ]</option>\r\n        <option value=\"ELIMINAR\">❌ [ ELIMINAR FORMA DE PAGO ]</option>\r\n      `;\r\n    }\r\n\r\n    sel.innerHTML = htmlOpciones;\r\n    sel.value = valorActual;\r\n  });\r\n}\r\n\r\nfunction verificarOpcionesPago(selectEl: HTMLSelectElement) {\r\n  if (selectEl.value === \"OTRA\") {\r\n    abrirModalPago(selectEl);\r\n  } else if (selectEl.value === \"ELIMINAR\") {\r\n    abrirModalEliminarPago(selectEl);\r\n  }\r\n}\r\n\r\n// ==========================================\r\n// REGISTRAR COBRO / PAGO PARCIAL DESDE FACTURA\r\n// ==========================================\r\nfunction abrirModalRegistrarCobro(tipo: \"venta\" | \"compra\") {\r\n  tipoModalActual = tipo; // Guarda si estás en venta o compra\r\n\r\n  const modal = document.getElementById(\"modal-registrar-cobro\");\r\n  const titulo = document.getElementById(\"modal-cobro-titulo\");\r\n  const inputIdFac = document.getElementById(\"cobro_id_factura\") as HTMLInputElement;\r\n  const inputTercero = document.getElementById(\"cobro_id_tercero\") as HTMLInputElement;\r\n  const inputImporteFac = document.getElementById(\"cobro_importe_factura\") as HTMLInputElement;\r\n  const inputImporteAbonar = document.getElementById(\"cobro_importe_abonar\") as HTMLInputElement;\r\n  const inputFecha = document.getElementById(\"cobro_fecha\") as HTMLInputElement;\r\n  const selectFormaPago = document.getElementById(\"cobro_forma_pago\") as HTMLSelectElement;\r\n  const inputObs = document.getElementById(\"cobro_observaciones\") as HTMLInputElement;\r\n\r\n  if (!modal || !inputIdFac) return;\r\n\r\n  const idFac =\r\n    tipo === \"venta\"\r\n      ? (document.getElementById(\"fac_id\") as HTMLInputElement).value.trim()\r\n      : (document.getElementById(\"com_id\") as HTMLInputElement).value.trim();\r\n\r\n  const numTercero =\r\n    tipo === \"venta\"\r\n      ? (document.getElementById(\"fac_num_cliente\") as HTMLSelectElement).value.trim()\r\n      : (document.getElementById(\"com_num_proveedor\") as HTMLSelectElement).value.trim();\r\n\r\n  const importeTotal =\r\n    tipo === \"venta\"\r\n      ? (document.getElementById(\"fac_importe\") as HTMLInputElement).value.trim()\r\n      : (document.getElementById(\"com_importe\") as HTMLInputElement).value.trim();\r\n\r\n  if (!idFac) {\r\n    alert(\"Selecciona una factura primero.\");\r\n    return;\r\n  }\r\n\r\n  actualizarSelectsFormasPago();\r\n\r\n  titulo!.innerHTML =\r\n    tipo === \"venta\"\r\n      ? `<i class=\"bi bi-cash-coin\"></i> Registrar Cobro - Factura Nº ${idFac}`\r\n      : `<i class=\"bi bi-cash\"></i> Registrar Pago - Factura Nº ${idFac}`;\r\n\r\n  inputIdFac.value = idFac;\r\n  inputTercero.value = numTercero;\r\n  inputImporteFac.value = importeTotal;\r\n  inputImporteAbonar.value = importeTotal;\r\n  inputFecha.value = new Date().toISOString().split(\"T\")[0];\r\n  selectFormaPago.value = \"CONTADO\";\r\n  inputObs.value = \"Abono a cuenta\";\r\n\r\n  modal.style.display = \"flex\";\r\n  inputImporteAbonar.focus();\r\n}\r\n\r\nfunction cerrarModalRegistrarCobro() {\r\n  const modal = document.getElementById(\"modal-registrar-cobro\");\r\n  if (modal) modal.style.display = \"none\";\r\n}\r\n\r\nasync function guardarCobroParcial() {\r\n  const tipo = tipoModalActual;\r\n  const idFac = (document.getElementById(\"cobro_id_factura\") as HTMLInputElement).value.trim();\r\n  const numTercero = (document.getElementById(\"cobro_id_tercero\") as HTMLInputElement).value.trim();\r\n  const importeAbonarStr = (document.getElementById(\"cobro_importe_abonar\") as HTMLInputElement).value.trim();\r\n  const fechaCobro = (document.getElementById(\"cobro_fecha\") as HTMLInputElement).value.trim();\r\n  const formaPago = (document.getElementById(\"cobro_forma_pago\") as HTMLSelectElement).value.trim();\r\n  const obs = (document.getElementById(\"cobro_observaciones\") as HTMLInputElement).value.trim();\r\n  const usuarioLog = usuarioActual || \"SISTEMA\";\r\n\r\n  const importeAbonar = parseFloat(importeAbonarStr);\r\n  if (isNaN(importeAbonar) || importeAbonar <= 0) {\r\n    alert(\"Introduce un importe válido a abonar.\");\r\n    return;\r\n  }\r\n\r\n  await Excel.run(async (context) => {\r\n    const nombreHojaHistorial = tipo === \"venta\" ? \"Historial_Cobros_Ventas\" : \"Historial_Pagos_Compras\";\r\n    const nombreHojaFacturas = tipo === \"venta\" ? \"Facturas_ventas\" : \"Facturas_compras\";\r\n\r\n    const sheetHist = context.workbook.worksheets.getItem(nombreHojaHistorial);\r\n    const usedRangeHist = sheetHist.getUsedRange();\r\n    usedRangeHist.load(\"rowCount\");\r\n\r\n    const sheetFac = context.workbook.worksheets.getItem(nombreHojaFacturas);\r\n    const rangeFacColA = sheetFac.getRange(\"A:A\");\r\n    rangeFacColA.load(\"text\");\r\n\r\n    await context.sync();\r\n\r\n    const rowHistIndex = usedRangeHist.rowCount;\r\n    sheetHist.getCell(rowHistIndex, 0).values = [[idFac]];\r\n    sheetHist.getCell(rowHistIndex, 1).values = [[numTercero]];\r\n    sheetHist.getCell(rowHistIndex, 2).values = [[fechaCobro]];\r\n    sheetHist.getCell(rowHistIndex, 3).values = [[importeAbonar]];\r\n    sheetHist.getCell(rowHistIndex, 4).values = [[formaPago]];\r\n    sheetHist.getCell(rowHistIndex, 5).values = [[obs]];\r\n    sheetHist.getCell(rowHistIndex, 6).values = [[usuarioLog]];\r\n\r\n    const valoresA = rangeFacColA.text;\r\n    let facturaRowIndex = -1;\r\n    for (let i = 0; i < valoresA.length; i++) {\r\n      if (String(valoresA[i][0]).trim() === idFac) {\r\n        facturaRowIndex = i;\r\n        break;\r\n      }\r\n    }\r\n\r\n    if (facturaRowIndex !== -1) {\r\n      const celdaImporte = sheetFac.getCell(facturaRowIndex, 5);\r\n      celdaImporte.load(\"values\");\r\n      await context.sync();\r\n      const importeTotalFac = parseFloat(String(celdaImporte.values[0][0])) || 0;\r\n\r\n      let totalPagado = importeAbonar;\r\n      const rangeHistValues = sheetHist.getUsedRange();\r\n      rangeHistValues.load(\"values\");\r\n      await context.sync();\r\n\r\n      const dataHist = rangeHistValues.values as (string | number)[][];\r\n      for (let i = 1; i < dataHist.length; i++) {\r\n        if (String(dataHist[i][0]).trim() === idFac && i !== rowHistIndex) {\r\n          totalPagado += parseFloat(String(dataHist[i][3])) || 0;\r\n        }\r\n      }\r\n\r\n      if (totalPagado >= importeTotalFac) {\r\n        sheetFac.getCell(facturaRowIndex, 6).values = [[\"PAGADA\"]];\r\n      }\r\n    }\r\n\r\n    await context.sync();\r\n    alert(\r\n      tipo === \"venta\"\r\n        ? \"¡Cobro registrado correctamente!\"\r\n        : \"¡Pago registrado correctamente en Historial_Pagos_Compras!\",\r\n    );\r\n    cerrarModalRegistrarCobro();\r\n\r\n    if (tipo === \"venta\") {\r\n      limpiarFormularioFactura();\r\n      await cargarTablaFacturas();\r\n    } else {\r\n      limpiarFormularioCompra();\r\n      await cargarTablaCompras();\r\n    }\r\n  });\r\n}\r\n\r\n// Exponer funciones al objeto global window para Script Lab\r\n(window as any).abrirModalRegistrarCobro = abrirModalRegistrarCobro;\r\n(window as any).cerrarModalRegistrarCobro = cerrarModalRegistrarCobro;\r\n(window as any).guardarCobroParcial = guardarCobroParcial;\r\n\r\n// ==========================================\r\n// DETECCIÓN DE ENTER EN BUSCADOR Y MOSTRAR BOTÓN\r\n// ==========================================\r\nfunction manejarEnterBuscadorFacturas(e: KeyboardEvent, tipo: \"venta\" | \"compra\") {\r\n  if (e.key === \"Enter\") {\r\n    e.preventDefault();\r\n    const inputBuscador = e.target as HTMLInputElement;\r\n    const valorBusqueda = inputBuscador.value.trim();\r\n    const btnDetalle = document.getElementById(tipo === \"venta\" ? \"btn-ver-detalle-factura\" : \"btn-ver-detalle-compra\");\r\n\r\n    if (valorBusqueda && btnDetalle) {\r\n      btnDetalle.style.display = \"inline-flex\";\r\n      if (tipo === \"venta\") {\r\n        renderizarTablaFacturas(datosCacheFacturas, valorBusqueda);\r\n      } else {\r\n        renderizarTablaCompras(datosCacheCompras, valorBusqueda);\r\n      }\r\n    } else if (btnDetalle) {\r\n      btnDetalle.style.display = \"none\";\r\n    }\r\n  }\r\n}\r\n\r\nfunction manejarEnterBuscadorPagos(e: KeyboardEvent, tipo: \"venta\" | \"compra\") {\r\n  if (e.key === \"Enter\") {\r\n    e.preventDefault();\r\n    const inputBuscador = e.target as HTMLInputElement;\r\n    const valorBusqueda = inputBuscador.value.trim();\r\n    const btnDetalle = document.getElementById(\r\n      tipo === \"venta\" ? \"btn-ver-detalle-pago-venta\" : \"btn-ver-detalle-pago-compra\",\r\n    );\r\n\r\n    if (valorBusqueda && btnDetalle) {\r\n      btnDetalle.style.display = \"inline-flex\";\r\n      if (tipo === \"venta\") {\r\n        renderizarTablaCobrosVentas(datosCacheCobrosVentas, valorBusqueda);\r\n      } else {\r\n        renderizarTablaPagosCompras(datosCachePagosCompras, valorBusqueda);\r\n      }\r\n    } else if (btnDetalle) {\r\n      btnDetalle.style.display = \"none\";\r\n    }\r\n  }\r\n}\r\n\r\n// ==========================================\r\n// CARGAR HISTORIAL DE PAGOS / COBROS\r\n// ==========================================\r\nasync function cargarHistorialCobrosVentas() {\r\n  try {\r\n    await Excel.run(async (context) => {\r\n      const sheet = context.workbook.worksheets.getItem(\"Historial_Cobros_Ventas\");\r\n      const range = sheet.getUsedRange();\r\n      range.load(\"values\");\r\n      await context.sync();\r\n\r\n      datosCacheCobrosVentas = range.values as (string | number)[][];\r\n      renderizarTablaCobrosVentas(datosCacheCobrosVentas);\r\n    });\r\n  } catch (e) {\r\n    console.log(\"Esperando datos de Historial_Cobros_Ventas...\");\r\n  }\r\n}\r\n\r\nfunction renderizarTablaCobrosVentas(data: (string | number)[][], filtro: string = \"\") {\r\n  const tbody = document.getElementById(\"tbody-pagos-clientes\");\r\n  if (!tbody) return;\r\n  tbody.innerHTML = \"\";\r\n  const filtroTexto = filtro.toLowerCase();\r\n\r\n  for (let i = 1; i < data.length; i++) {\r\n    const row = data[i];\r\n    if (row && row[0]) {\r\n      const idFac = String(row[0] || \"\");\r\n      const numCli = String(row[1] || \"\");\r\n      const fechaCobro = formatearFechaExcel(row[2]);\r\n      const importe = String(row[3] || \"\");\r\n      const formaPago = String(row[4] || \"\");\r\n      const obs = String(row[5] || \"\");\r\n      const log = String(row[6] || \"\");\r\n\r\n      if (\r\n        filtroTexto &&\r\n        !idFac.toLowerCase().includes(filtroTexto) &&\r\n        !numCli.toLowerCase().includes(filtroTexto) &&\r\n        !formaPago.toLowerCase().includes(filtroTexto)\r\n      )\r\n        continue;\r\n\r\n      const tr = document.createElement(\"tr\");\r\n      tr.innerHTML = `\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${idFac}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${numCli}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: center;\">${fechaCobro}</td>\r\n        <td style=\"padding: 3px; border: 1px solid #c8c6c4; text-align: right;\">${importe} 