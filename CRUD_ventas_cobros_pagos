ody>\r\n\t\t\t\t\t\t\t\t\t\t\t</table>\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t\t\t\t\t<div style=\"display: flex; gap: 6px;\">\r\n\t\t\t\t\t\t\t\t\t\t<button type=\"button\" class=\"btn-primary\" style=\"flex:1;\" onclick=\"prepararHojaImpresion()\"><i class=\"bi bi-printer\"></i> Preparar para Imprimir</button>\r\n\t\t\t\t\t\t\t\t\t\t<button type=\"button\" class=\"btn-secondary\" style=\"flex:1;\" onclick=\"cerrarDetalleFactura()\"><i class=\"bi bi-x-lg\"></i> Cerrar</button>\r\n\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>"
