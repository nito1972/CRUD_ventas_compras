padding: 5px 8px;\r\n    border-bottom: 1px solid #eee;\r\n    font-size: 11px;\r\n    background: #fdfdfd;\r\n}\r\n\r\n.fila-item-pago span {\r\n    font-weight: 600;\r\n    color: #333;\r\n}\r\n\r\n.btn-borrar-pago {\r\n    background-color: #a80000;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 3px;\r\n    padding: 3px 8px;\r\n    cursor: pointer;\r\n    font-size: 10px;\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 3px;\r\n    flex: unset !important;\r\n}\r\n\r\n.btn-borrar-pago:hover {\r\n    background-color: #d13438;\r\n}"
