  content: "<div class=\"app-container\">\r\n\t<!-- Menú Lateral (Sidebar) -->\r\n\t<aside class=\"sidebar\">\r\n\t\t<div class=\"sidebar-header\">\r\n\t\t\t<h3><i class=\"bi bi-grid-fill\"></i> Menú Principal</h3>\r\n\t\t</div>\r\n\t\t<ul class=\"sidebar-menu\">\r\n\t\t\t<!-- Menú Maestros -->\r\n\t\t\t<li class=\"has-submenu\">\r\n\t\t\t\t<a href=\"#\" id=\"menu-maestros\" onclick=\"toggleSubmenu(event, 'submenu-maestros', 'icon-maestros')\">\r\n\t\t\t\t\t<span><i class=\"bi bi-folder-fill\"></i> Maestros</span>\r\n\t\t\t\t\t<i class=\"bi bi-chevron-down toggle-icon\" id=\"icon-maestros\"></i>\r\n\t\t\t\t</a>\r\n\t\t\t\t<ul class=\"submenu\" id=\"submenu-maestros\">\r\n\t\t\t\t\t<li><a href=\"#\"\r\n\t\t\t\t\t\t\tonclick=\"mostrarVista('clientes')\"><i class=\"bi bi-person-badge-fill icon-menu-cli\"></i>\r\n\t\t\t\t\t\t\tClientes</a></li>\r\n\t\t\t\t\t<li><a href=\"#\"\r\n\t\t\t\t\t\t\tonclick=\"mostrarVista('proveedores')\"><i class=\"bi bi-building-fill-gear icon-menu-prov\"></i>\r\n\t\t\t\t\t\t\tProveedores</a></li>\r\n\t\t\t\t</ul>\r\n\t\t\t</li>\r\n\r\n\t\t\t<!-- Menú Documentos -->\r\n\t\t\t<li class=\"has-submenu\" style=\"margin-top: 5px;\">\r\n\t\t\t\t<a href=\"#\" id=\"menu-documentos\"\r\n\t\t\t\t\tonclick=\"toggleSubmenu(event, 'submenu-documentos', 'icon-documentos')\">\r\n\t\t\t\t\t<span><i class=\"bi bi-file-earmark-text-fill\"></i> Documentos</span>\r\n\t\t\t\t\t<i class=\"bi bi-chevron-down toggle-icon\" id=\"icon-documentos\"></i>\r\n\t\t\t\t</a>\r\n\t\t\t\t<ul class=\"submenu\" id=\"submenu-documentos\">\r\n\t\t\t\t\t<li><a href=\"#\"\r\n\t\t\t\t\t\t\tonclick=\"mostrarVista('facturas_ventas')\"><i class=\"bi bi-receipt icon-menu-fact\"></i>\r\n\t\t\t\t\t\t\tFacturas ventas</a></li>\r\n\t\t\t\t\t<li><a href=\"#\"\r\n\t\t\t\t\t\t\tonclick=\"mostrarVista('facturas_compras')\"><i class=\"bi bi-cart-check-fill icon-menu-compras\"></i>\r\n\t\t\t\t\t\t\tFacturas compras</a></li>\r\n\t\t\t\t</ul>\r\n\t\t\t</li>\r\n\r\n\t\t\t<!-- Menú Estado cuentas -->\r\n\t\t\t<li class=\"has-submenu\" style=\"margin-top: 5px;\">\r\n\t\t\t\t<a href=\"#\" id=\"menu-estado\" onclick=\"toggleSubmenu(event, 'submenu-estado', 'icon-estado')\">\r\n\t\t\t\t\t<span><i class=\"bi bi-wallet2\"></i> Estado cuentas</span>\r\n\t\t\t\t\t<i class=\"bi bi-chevron-down toggle-icon\" id=\"icon-estado\"></i>\r\n\t\t\t\t</a>\r\n\t\t\t\t<ul class=\"submenu\" id=\"submenu-estado\">\r\n\t\t\t\t\t<li><a href=\"#\"\r\n\t\t\t\t\t\t\tonclick=\"mostrarVista('pagos_clientes')\"><i class=\"bi bi-cash-coin\" style=\"color: #107c41;\"></i>\r\n\t\t\t\t\t\t\tPagos clientes</a></li>\r\n\t\t\t\t\t<li><a href=\"#\"\r\n\t\t\t\t\t\t\tonclick=\"mostrarVista('pagos_proveedores')\"><i class=\"bi bi-cash\" style=\"color: #d83b01;\"></i>\r\n\t\t\t\t\t\t\tPagos proveedores</a></li>\r\n\t\t\t\t</ul>\r\n\t\t\t</li>\r\n\t\t</ul>\r\n\t</aside>\r\n\r\n\t<!-- Contenido Principal -->\r\n\t<main class=\"main-content\">\r\n\r\n\t\t<!-- VISTA DE INICIO -->\r\n\t\t<div id=\"vista-inicio\" class=\"vista-panel active\">\r\n\t\t\t<h2><i class=\"bi bi-house-door-fill\"></i> Panel de Control</h2>\r\n\t\t\t<p>Selecciona una opción del menú lateral izquierdo (<strong>Maestros</strong>, <strong>Documentos</strong>\r\n\t\t\t\to <strong>Estado cuentas</strong>).</p>\r\n\t\t</div>\r\n\r\n\t\t<!-- VISTA DE CLIENTES -->\r\n\t\t<div id=\"vista-clientes\" class=\"vista-panel tema-clientes\">\r\n\t\t\t<h2><i class=\"bi bi-people-fill\"></i> Gestión de Clientes</h2>\r\n\t\t\t<div class=\"form-group search-box\">\r\n\t\t\t\t<label><i class=\"bi bi-search\"></i> Buscar (Nombre, DNI o Nº):</label>\r\n\t\t\t\t<input type=\"text\" id=\"buscador\" class=\"mayus\" placeholder=\"Escribe para filtrar...\" />\r\n\t\t\t</div>\r\n\t\t\t\t<div class=\"form-group\">\r\n\t\t\t\t\t<label>Num Cliente (Automático):</label><input type=\"text\" id=\"num_cliente\" readonly style=\"background-color: #e9ecef; cursor: not-allowed;\" />\r\n\t\t\t</div>\r\n\t\t\t\t\t<div class=\"form-group\">\r\n\t\t\t\t\t\t<label>Nombre:</lab